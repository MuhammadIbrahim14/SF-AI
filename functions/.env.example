# DEPRECATED for PayFast — use skillforge_ai_gateway/.env instead.
# See docs/PAYFAST_SETUP.md
#
# PayFast Pakistan keys (where to get them):
# 1. Register at https://gopayfast.com/ / https://getstarted.apps.net.pk/signup
# 2. After merchant approval, copy MERCHANT_ID and SECURED_KEY from PayFast
# 3. Put them in skillforge_ai_gateway/.env as:
#    PAYFAST_MERCHANT_ID=
#    PAYFAST_SECURED_KEY=

PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=SkillForge AI
PAYFAST_CURRENCY=PKR
PAYFAST_SANDBOX=false
# Legacy Functions base URL (not used by Flutter anymore):
PAYFAST_FUNCTIONS_BASE_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net
