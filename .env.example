# Root env template — copy to `.env` locally. Never commit real secrets.
# Flutter / tooling may read these; the AI gateway uses skillforge_ai_gateway/.env

FIREBASE_PROJECT_ID=skillforge-ai-4f2da
AI_GATEWAY_BASE_URL=http://localhost:3001

# Provider keys (leave empty in repo; set locally)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Production: always true. Local-only: set false explicitly for unauthenticated gateway tests.
REQUIRE_AUTH=true
