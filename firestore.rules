rules_version = '2';

service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() {
   return request.auth != null;
  }

  function userPath(uid) {
   return /databases/$(database)/documents/users/$(uid);
  }

  function adminPath(uid) {
   return /databases/$(database)/documents/admins/$(uid);
  }

  function jobPath(jobId) {
 return /databases/$(database)/documents/jobs/$(jobId);
 }

  function applicationPath(applicationId) {
 return /databases/$(database)/documents/applications/$(applicationId);
 }

  function hiringAccessDocPath(candidateId) {
   return /databases/$(database)/documents/hiring_candidate_access/$(request.auth.uid + '_' + candidateId);
  }

  function hasBoundHiringCandidateAccess(candidateId) {
   return hasRole('company')
   && exists(hiringAccessDocPath(candidateId))
   && hiringAccessBoundToCompany(
   get(hiringAccessDocPath(candidateId)).data,
   candidateId
   );
  }

  function hiringAccessBoundToCompany(data, candidateId) {
   return data.companyId == request.auth.uid
   && data.candidateId == candidateId;
  }

  function companyIsVerified() {
   return exists(/databases/$(database)/documents/companies/$(request.auth.uid))
   && get(/databases/$(database)/documents/companies/$(request.auth.uid))
   .data.get('verificationStatus', 'pending') in ['approved', 'verified'];
  }

    function hiringAccessWriteValid() {
   return request.resource.data.companyId is string
   && request.resource.data.candidateId is string
   && request.resource.data.applicationId is string
   && request.resource.data.jobId is string
   && request.resource.data.module == 'company_hiring'
   && exists(applicationPath(request.resource.data.applicationId))
   && applicationMatchesHiringAccess(
   get(applicationPath(request.resource.data.applicationId)).data
   );
  }

  function applicationMatchesHiringAccess(app) {
   return app.companyId == request.resource.data.companyId
   && app.applicantId == request.resource.data.candidateId
   && app.jobId == request.resource.data.jobId;
  }

  function currentUserExists() {
   return signedIn() && exists(userPath(request.auth.uid));
  }

  function currentUserData() {
   return get(userPath(request.auth.uid)).data;
  }

  function isActiveUser() {
   return currentUserExists()
   && !(currentUserData().get('status', 'active') in ['banned', 'suspended']);
  }

  function roleAliases(role) {
   return role in ['superAdmin', 'super_admin', 'superadmin']
   ? ['superAdmin', 'super_admin', 'superadmin']
   : [role];
  }

  function documentHasRole(data, role) {
   return documentHasAnyRoleAlias(data, roleAliases(role));
  }

  function documentHasAnyRoleAlias(data, aliases) {
   return data.get('primaryRole', '') in aliases
   || data.get('role', '') in aliases
   || (
   data.get('roles', []) is list
   && data.get('roles', []).hasAny(aliases)
   );
  }

  function hasRole(role) {
   return signedIn()
   && exists(userPath(request.auth.uid))
   && userIsActiveWithRole(get(userPath(request.auth.uid)).data, role);
  }

  function userIsActiveWithRole(data, role) {
   return !(data.get('status', 'active') in ['banned', 'suspended'])
   && documentHasRole(data, role);
  }

  function adminProfileHasRole(role) {
   return signedIn()
   && exists(adminPath(request.auth.uid))
   && adminDataHasRole(get(adminPath(request.auth.uid)).data, role);
  }

  function adminDataHasRole(data, role) {
   return !(data.get('status', 'active') in ['banned', 'suspended'])
   && (
   documentHasRole(data, role)
   || data.get('primaryRole', '') in roleAliases(role)
   || data.get('accessLevel', '') in roleAliases(role)
   || data.get('role', '') in roleAliases(role)
   || data.get('permissionLevel', '') in roleAliases(role)
   || (role == 'admin' && data.get('admin', false) == true)
   || (
   role in ['superAdmin', 'super_admin', 'superadmin']
   && (
   data.get('isSuperAdmin', false) == true
   || data.get('superAdmin', false) == true
   || data.get('super_admin', false) == true
   || data.get('superadmin', false) == true
   )
   )
   );
  }

  function activeAdminProfileExists() {
   return signedIn()
   && exists(adminPath(request.auth.uid))
   && !(get(adminPath(request.auth.uid)).data.get('status', 'active') in ['banned', 'suspended']);
  }

  function isAdmin() {
   return activeAdminProfileExists() || userHasAdminLikeRole();
  }

  function userHasAdminLikeRole() {
   return signedIn()
   && exists(userPath(request.auth.uid))
   && userIsActiveAdminLike(get(userPath(request.auth.uid)).data);
  }

  function userIsActiveAdminLike(data) {
   return !(data.get('status', 'active') in ['banned', 'suspended'])
   && (
   documentHasRole(data, 'admin')
   || documentHasRole(data, 'super_admin')
   );
  }

  function isSuperAdmin() {
   return hasRole('super_admin')
   || adminProfileHasRole('super_admin');
  }

  function isAdminRole(role) {
   return role in ['admin', 'superAdmin', 'super_admin', 'superadmin'];
  }

  function coursePath(courseId) {
   return /databases/$(database)/documents/courses/$(courseId);
  }

  function courseExists(courseId) {
   return exists(coursePath(courseId));
  }

  function courseIsPublished(courseId) {
   return courseExists(courseId)
   && (
   get(coursePath(courseId)).data.status == 'published'
   || get(coursePath(courseId)).data.isPublished == true
   );
  }

  function courseIsFreeToEnroll(courseId) {
   return !exists(/databases/$(database)/documents/paid_courses/$(courseId))
   || get(/databases/$(database)/documents/paid_courses/$(courseId)).data.get('isPaid', false) != true
   || get(/databases/$(database)/documents/paid_courses/$(courseId)).data.get('price', 0) <= 0;
  }

  function ownsCourse(courseId) {
   return hasRole('teacher')
   && courseExists(courseId)
   && get(coursePath(courseId)).data.teacherId == request.auth.uid;
  }

  function teacherBatchPath(batchId) {
   return /databases/$(database)/documents/teacherBatches/$(batchId);
  }

  function ownsTeacherBatch(batchId) {
   return hasRole('teacher')
   && exists(teacherBatchPath(batchId))
   && get(teacherBatchPath(batchId)).data.teacherId == request.auth.uid;
  }

  function isTeacherBatchRosterMember(batchId) {
   return hasRole('student')
   && exists(teacherBatchPath(batchId))
   && request.auth.uid in get(teacherBatchPath(batchId)).data.get(
   'studentIds',
   []
   );
  }

  function ownsJob(jobId) {
   return hasRole('company')
   && exists(jobPath(jobId))
   && get(jobPath(jobId)).data.companyId == request.auth.uid;
  }

  function ownsApplication(applicationId) {
   return hasRole('company')
   && exists(applicationPath(applicationId))
   && (
   get(applicationPath(applicationId)).data.companyId == request.auth.uid
   || ownsJob(get(applicationPath(applicationId)).data.jobId)
   );
  }

  function enrollmentPath(courseId, studentId) {
   return /databases/$(database)/documents/enrollments/$(studentId + '_' + courseId);
  }

  function srPath(id) {
   return /databases/$(database)/documents/serviceRequests/$(id);
  }
  function soPath(id) {
 return /databases/$(database)/documents/serviceOrders/$(id);
 }
 function hrThread(threadId) {
 return get(/databases/$(database)/documents/employmentHrThreads/$(threadId)).data;
 }
 function isHrParty(d) {
 return d.companyId == request.auth.uid || d.applicantId == request.auth.uid;
 }
 function soAfter(id) {
 return getAfter(soPath(id)).data;
 }
 function soGet(id) {
 return get(soPath(id)).data;
 }
  function notifCfPeer(d) {
   return (d.clientId == request.auth.uid
   && request.resource.data.userId == d.freelancerId)
   || (d.freelancerId == request.auth.uid
   && request.resource.data.userId == d.clientId);
  }
  function notifSrPeer() {
   return request.resource.data.serviceRequestId is string
   && exists(srPath(request.resource.data.serviceRequestId))
   && notifCfPeer(get(srPath(request.resource.data.serviceRequestId)).data);
  }
  function notifSoPeer() {
   return request.resource.data.orderId is string
   && exists(soPath(request.resource.data.orderId))
   && notifCfPeer(soGet(request.resource.data.orderId));
  }
  function notifHiringPeer() {
   return request.resource.data.applicationId is string
   && exists(applicationPath(request.resource.data.applicationId))
   && notifHireParties(
   get(applicationPath(request.resource.data.applicationId)).data
   );
  }
  function notifHireParties(d) {
   return (d.companyId == request.auth.uid || d.applicantId == request.auth.uid)
   && (request.resource.data.userId == d.companyId
   || request.resource.data.userId == d.applicantId);
  }
  function notifBatchPeer() {
   return request.resource.data.batchId is string
   && exists(teacherBatchPath(request.resource.data.batchId))
   && (
   get(teacherBatchPath(request.resource.data.batchId)).data.teacherId
   == request.auth.uid
   || (
   hasRole('student')
   && request.resource.data.userId
   == get(teacherBatchPath(request.resource.data.batchId)).data.teacherId
   )
   );
  }
  function notifCoursePeer() {
   return request.resource.data.courseId is string
   && ownsCourse(request.resource.data.courseId)
   && exists(enrollmentPath(
   request.resource.data.courseId,
   request.resource.data.userId
   ));
  }

  function isEnrolled(courseId) {
   return signedIn()
   && exists(enrollmentPath(courseId, request.auth.uid))
   && !(currentUserData().get('status', 'active') in ['banned', 'suspended']);
  }

  function registrationEnabled() {
   return !exists(
   /databases/$(database)/documents/settings/platform
   )
   || get(
   /databases/$(database)/documents/settings/platform
   ).data.get(
   'registrationEnabled',
   get(
   /databases/$(database)/documents/settings/platform
   ).data.get('allowRegistrations', true)
   ) == true;
  }

  function hasSelectableRole(data) {
   return data.get('primaryRole', null) == null
   || data.primaryRole in ['student', 'teacher', 'freelancer', 'company'];
  }

  function hasSelectableRoles(data) {
   return data.get('roles', []) is list
   && data.get('roles', []).hasOnly(['student', 'teacher', 'freelancer', 'company']);
  }

  function hasValidAccountType(data) {
   return data.get('accountType', 'professional') in ['professional', 'customer'];
  }

  function studentAiThreadPath(threadId) {
   return /databases/$(database)/documents/studentAiTutorThreads/$(threadId);
  }

  function ownsStudentAiThread(threadId) {
   return isActiveUser()
   && exists(studentAiThreadPath(threadId))
   && get(studentAiThreadPath(threadId)).data.studentId == request.auth.uid;
  }

  match /aiSettings/{documentId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /aiRoleQuotas/{roleId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /aiFeatureCosts/{taskType} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /aiUserCredits/{userId} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == userId);
   allow create: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == userId
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.bonusCredits == 0
   && request.resource.data.usedCreditsThisMonth == 0
   && request.resource.data.monthlyFreeCredits is int
   && request.resource.data.monthlyFreeCredits >= 0
   && request.resource.data.monthlyFreeCredits <= 500
   && request.resource.data.remainingCredits
   == request.resource.data.monthlyFreeCredits
   );
   allow update: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == userId
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.monthlyFreeCredits
   == resource.data.get('monthlyFreeCredits', request.resource.data.monthlyFreeCredits)
   && request.resource.data.bonusCredits
   == resource.data.get('bonusCredits', 0)
   && request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedCreditsThisMonth', 'remainingCredits', 'currentMonthKey', 'role', 'userId', 'updatedAt'])
   && (
   (
   request.resource.data.currentMonthKey
   == resource.data.get('currentMonthKey', request.resource.data.currentMonthKey)
   && request.resource.data.usedCreditsThisMonth
   >= resource.data.get('usedCreditsThisMonth', 0)
   && request.resource.data.remainingCredits
   <= resource.data.get(
   'remainingCredits',
   request.resource.data.remainingCredits
   )
   && request.resource.data.remainingCredits
   == (
   request.resource.data.monthlyFreeCredits
   + request.resource.data.bonusCredits
   - request.resource.data.usedCreditsThisMonth
   )
   )
   || (
   request.resource.data.currentMonthKey
   != resource.data.get('currentMonthKey', '')
   && request.resource.data.usedCreditsThisMonth == 0
   && request.resource.data.remainingCredits
   == (
   request.resource.data.monthlyFreeCredits
   + request.resource.data.bonusCredits
   )
   )
   )
   );
   allow delete: if isAdmin();
  }

  match /aiUsageLogs/{logId} {
   allow read: if isAdmin()
   || (isActiveUser() && resource.data.userId == request.auth.uid);
   allow create: if isActiveUser()
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.creditsCharged >= 0;
   allow update, delete: if false;
  }

  match /aiCreditRequests/{requestId} {
   allow read: if isAdmin()
   || (isActiveUser() && resource.data.userId == request.auth.uid);
   allow create: if isActiveUser()
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.status == 'pending'
   && request.resource.data.requestedCredits > 0;
   allow update, delete: if isAdmin();
  }

  match /aiCreditPacks/{packId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /appPublicConfig/{documentId} {
   allow read: if documentId in ['releaseCenter', 'portfolioSettings']
   || (documentId == 'emailjs' && (isActiveUser() || isAdmin()));
   allow create, update, delete: if documentId in ['releaseCenter', 'portfolioSettings', 'emailjs']
   && isAdmin();
  }

  match /teacherBatches/{batchId} {
   allow read: if isAdmin()
   || (
   hasRole('teacher')
   && resource.data.teacherId == request.auth.uid
   )
   || (
   hasRole('student')
   && request.auth.uid in resource.data.get('studentIds', [])
   );

   allow create: if hasRole('teacher')
   && request.resource.data.teacherId == request.auth.uid
   && request.resource.data.keys().hasOnly([
   'teacherId', 'title', 'description', 'courseIds', 'studentIds', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt',
   'inviteCode', 'inviteEnabled'
   ]);

   allow update: if isAdmin()
   || (
   hasRole('teacher')
   && resource.data.teacherId == request.auth.uid
   && request.resource.data.teacherId == resource.data.teacherId
   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'courseIds', 'studentIds', 'startDate', 'endDate', 'status', 'updatedAt', 'inviteCode', 'inviteEnabled'])
   );

   allow delete: if isAdmin();

   match /attendance/{dateId} {
    allow read, write: if ownsTeacherBatch(batchId) || isAdmin();
   }

   match /announcements/{announcementId} {
    allow read: if isAdmin()
    || ownsTeacherBatch(batchId)
    || isTeacherBatchRosterMember(batchId);
    allow write: if ownsTeacherBatch(batchId);
   }

   match /sessions/{sessionId} {
    allow read: if ownsTeacherBatch(batchId)
    || isTeacherBatchRosterMember(batchId)
    || isAdmin();
    allow write: if ownsTeacherBatch(batchId);
   }

   match /joinRequests/{requestId} {
    allow read: if ownsTeacherBatch(batchId)
    || (hasRole('student') && resource.data.studentId == request.auth.uid);
    allow create: if hasRole('student')
    && request.resource.data.studentId == request.auth.uid
    && request.resource.data.status == 'pending';
    allow update: if ownsTeacherBatch(batchId);
    allow delete: if false;
   }
  }

  match /batchInviteCodes/{code} {
   allow get: if signedIn();
   allow list: if false;
   allow create, update: if hasRole('teacher')
   && request.resource.data.teacherId == request.auth.uid;
   allow delete: if hasRole('teacher')
   && resource.data.teacherId == request.auth.uid;
  }

  match /careerRoadmaps/{studentId}/roadmaps/{roadmapId} {
   allow read: if isAdmin()
   || (
   hasRole('student')
   && studentId == request.auth.uid
   );

   allow create, update: if hasRole('student')
   && studentId == request.auth.uid
   && request.resource.data.keys().hasOnly(['targetRole', 'requiredSkills', 'currentSkills', 'missingSkills', 'recommendedCourses', 'recommendedProjects', 'progressPercent', 'createdAt', 'updatedAt']);

   allow delete: if isAdmin()
   || (
   hasRole('student')
   && studentId == request.auth.uid
   );
  }

  match /userVerifiedSkills/{userId}/skills/{skillId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && userId == request.auth.uid
   );
   allow create, update: if hasRole('student')
   && userId == request.auth.uid
   && request.resource.data.keys().hasOnly(['skillName', 'sourceCourseIds', 'sourceProjectIds', 'evidenceType', 'verificationLevel', 'completedAt', 'score', 'publicVisible']);
   allow delete: if isAdmin()
   || (
   hasRole('student')
   && userId == request.auth.uid
   );
  }

  match /freelancerShowcases/{userId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && userId == request.auth.uid
   );
   allow create, update: if hasRole('student')
   && userId == request.auth.uid
   && request.resource.data.ownerId == request.auth.uid
   && request.resource.data.keys().hasOnly([
   'ownerId', 'displayName', 'photoUrl', 'headline', 'bio', 'serviceCategory', 'verifiedSkills', 'verifiedSkillCount', 'isPublic', 'source',
   'updatedAt', 'createdAt', 'requestedFreelancerActivation', 'status'
   ]);
   allow delete: if isAdmin();
  }

  match /publicProfiles/{profileSlug} {
   allow read: if resource.data.publicVisible == true
   || resource.data.isPublic == true
   || isAdmin();
   allow create, update: if isActiveUser()
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.ownerId == request.auth.uid
   && request.resource.data.keys().hasOnly([
   'slug', 'userId', 'ownerId', 'roleType', 'displayName', 'avatarUrl', 'photoUrl', 'headline', 'bio', 'location',
   'skills', 'serviceCategory', 'verifiedSkills', 'verifiedSkillCount', 'projects', 'services', 'coursesCreated', 'certificates', 'reviews', 'socialLinks',
   'contactMode', 'hireButtonEnabled', 'publicVisible', 'isPublic', 'source', 'updatedAt', 'createdAt'
   ]);
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.userId == request.auth.uid
   );
  }

  match /studentAiTutorThreads/{threadId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(studentAiThreadPath(threadId))
   )
   || (
   isActiveUser()
   && resource.data.studentId == request.auth.uid
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && resource.data.studentId == request.auth.uid
   );

   allow create: if hasRole('student')
   && request.resource.data.studentId == request.auth.uid
   && request.resource.data.scope in ['course', 'lesson', 'assignment', 'quiz', 'project', 'general']
   && request.resource.data.source == 'studentAiTutor';

   allow update: if isAdmin()
   || (
   hasRole('student')
   && resource.data.studentId == request.auth.uid
   && request.resource.data.studentId == resource.data.studentId
   && request.resource.data.diff(resource.data).changedKeys().hasOnly(['title', 'lastMessagePreview', 'lastMessageAt', 'updatedAt', 'messageCount', 'isArchived', 'contextSummary'])
   );

   allow delete: if false;

   match /messages/{messageId} {
    allow read: if isAdmin() || ownsStudentAiThread(threadId);

    allow create: if hasRole('student')
    && ownsStudentAiThread(threadId)
    && request.resource.data.threadId == threadId
    && request.resource.data.studentId == request.auth.uid
    && request.resource.data.role in ['user', 'assistant', 'system']
    && request.resource.data.status in ['sending', 'sent', 'failed']
    && request.resource.data.content is string
    && request.resource.data.creditsCharged >= 0;

    allow update: if hasRole('student')
    && ownsStudentAiThread(threadId)
    && resource.data.studentId == request.auth.uid
    && request.resource.data.studentId == resource.data.studentId
    && request.resource.data.threadId == threadId
    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'errorCode', 'updatedAt']);

    allow delete: if false;
   }
  }

  match /users/{uid} {
   allow read: if signedIn()
   && (
   request.auth.uid == uid
   || isAdmin()
   || (
   hasRole('teacher')
   && documentHasRole(resource.data, 'student')
   )
   || (
   hasRole('company')
   && (
   documentHasRole(resource.data, 'student')
   || documentHasRole(resource.data, 'freelancer')
   )
   )
   );

   allow create: if signedIn()
   && request.auth.uid == uid
   && registrationEnabled()
   && request.resource.data.get('status', 'active') == 'active'
   && hasSelectableRole(request.resource.data)
   && hasSelectableRoles(request.resource.data)
   && hasValidAccountType(request.resource.data);

   allow update: if isSuperAdmin()
   || (
   isAdmin()
   && request.auth.uid != uid
   && !isAdminRole(resource.data.get('primaryRole', null))
   && !isAdminRole(request.resource.data.get('primaryRole', null))
   )
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['lastLogin', 'lastSeenAt', 'updatedAt'])
   )
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.get('status', 'active')
   == resource.data.get('status', 'active')
   && hasSelectableRole(request.resource.data)
   && hasSelectableRoles(request.resource.data)
   && hasValidAccountType(request.resource.data)
   );

   allow delete: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
  }

  match /students/{uid} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid)
   || hasBoundHiringCandidateAccess(uid);
   allow write: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
  }

  match /teachers/{uid} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
   allow create: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.get('verificationStatus', 'pending')
   == 'pending'
   );
   allow update: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.get('verificationStatus', 'pending')
   == resource.data.get('verificationStatus', 'pending')
   );
   allow delete: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
  }

  match /freelancers/{uid} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid)
   || hasBoundHiringCandidateAccess(uid);
   allow write: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
  }

  match /freelancerServices/{serviceId} {
   allow read: if resource.data.isPublished == true
   || isAdmin()
   || (
   hasRole('freelancer')
   && resource.data.freelancerId == request.auth.uid
   );

   allow create: if hasRole('freelancer')
   && request.resource.data.freelancerId == request.auth.uid
   && request.resource.data.status in ['draft', 'published', 'hidden']
   && request.resource.data.isPublished
   == (request.resource.data.status == 'published');

   allow update: if hasRole('freelancer')
   && resource.data.freelancerId == request.auth.uid
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.status in ['draft', 'published', 'hidden']
   && request.resource.data.isPublished
   == (request.resource.data.status == 'published');

   allow delete: if hasRole('freelancer')
   && resource.data.freelancerId == request.auth.uid;
  }

  match /serviceRequests/{requestId} {
   allow create: if isActiveUser()
   && request.resource.data.requestId == requestId
   && request.resource.data.clientId == request.auth.uid
   && request.resource.data.status == 'pending'
   && request.resource.data.priority in ['low', 'normal', 'high']
   && exists(
   /databases/$(database)/documents/freelancerServices/$(request.resource.data.serviceId)
   )
   && get(
   /databases/$(database)/documents/freelancerServices/$(request.resource.data.serviceId)
   ).data.isPublished == true
   && get(
   /databases/$(database)/documents/freelancerServices/$(request.resource.data.serviceId)
   ).data.status == 'published'
   && request.resource.data.freelancerId
   == get(
   /databases/$(database)/documents/freelancerServices/$(request.resource.data.serviceId)
   ).data.freelancerId;

   allow read: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   )
   );

   allow update: if (
   hasRole('freelancer')
   && resource.data.freelancerId == request.auth.uid
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'updatedAt', 'acceptedAt', 'deliveredAt', 'completedAt', 'cancelledAt', 'freelancerNote'])
   && (
   (
   resource.data.status == 'pending'
   && request.resource.data.status in ['accepted', 'rejected']
   )
   )
   )
   || (
   isActiveUser()
   && resource.data.clientId == request.auth.uid
   && resource.data.status == 'pending'
   && request.resource.data.status == 'cancelled'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'updatedAt', 'cancelledAt', 'clientNote'])
   )
   ;

   allow delete: if false;
  }

  match /serviceOrders/{orderId} {
   allow create: if isActiveUser()
   && request.resource.data.orderId == orderId
   && request.resource.data.serviceRequestId == orderId
   && request.resource.data.clientId == request.auth.uid
   && request.resource.data.orderStatus == 'pending'
   && request.resource.data.paymentStatus == 'unpaid'
   && request.resource.data.escrowStatus == 'notFunded'
   && request.resource.data.subtotal is number
   && request.resource.data.subtotal > 0
   && request.resource.data.selectedPackagePrice is number
   && request.resource.data.selectedPackagePrice > 0
   && request.resource.data.selectedDeliveryDays is number
   && request.resource.data.selectedDeliveryDays >= 1
   && request.resource.data.dueDate is timestamp
   && request.resource.data.taxTotal == 0
   && request.resource.data.totalAmount == request.resource.data.subtotal
   && request.resource.data.totalAmount == request.resource.data.selectedPackagePrice
   && request.resource.data.platformFee >= 0
   && request.resource.data.freelancerEarnings >= 0
   && exists(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   )
   && get(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   ).data.clientId == request.auth.uid
   && get(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   ).data.status == 'accepted'
   && request.resource.data.serviceId == get(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   ).data.serviceId
   && request.resource.data.freelancerId == get(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   ).data.freelancerId;

   allow get: if isAdmin()
   || (
   signedIn()
   && !exists(
   soPath(orderId)
   )
   )
   || (
   signedIn()
   && !exists(
   soPath(orderId)
   )
   && exists(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   )
   && get(
   /databases/$(database)/documents/serviceRequests/$(orderId)
   ).data.clientId == request.auth.uid
   )
   || (
   signedIn()
   && exists(
   soPath(orderId)
   )
   && (
   soGet(orderId).clientId == request.auth.uid
   || soGet(orderId).freelancerId == request.auth.uid
   )
   );

   allow list: if isAdmin()
   || (
   signedIn()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow update: if isActiveUser()
   && resource.data.clientId == request.auth.uid
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.serviceRequestId == resource.data.serviceRequestId
   && (
   (
   resource.data.orderStatus == 'pending'
   && resource.data.paymentStatus == 'unpaid'
   && resource.data.escrowStatus == 'notFunded'
   && request.resource.data.orderStatus == 'cancelled'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['orderStatus', 'updatedAt', 'cancelledAt'])
   )
   || (
   resource.data.orderStatus == 'pending'
   && resource.data.paymentStatus == 'unpaid'
   && resource.data.escrowStatus == 'notFunded'
   && request.resource.data.orderStatus == 'active'
   && request.resource.data.paymentStatus == 'demoPaid'
   && request.resource.data.escrowStatus == 'held'
   && request.resource.data.sandboxPaymentMethod == 'SkillForge Wallet'
   && request.resource.data.transactionReference is string
   && request.resource.data.transactionReference.size() > 0
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.clientId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.freelancerId == resource.data.freelancerId
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.status == 'held'
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.amount == resource.data.totalAmount
   && getAfter(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.availableBalance == get(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.availableBalance - resource.data.totalAmount
   && getAfter(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.totalSpent == get(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.totalSpent + resource.data.totalAmount
   && getAfter(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.totalEscrowed == get(
   /databases/$(database)/documents/customerWallets/$(resource.data.clientId)
   ).data.totalEscrowed + resource.data.totalAmount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['paymentStatus', 'escrowStatus', 'orderStatus', 'paidAt', 'escrowHeldAt', 'expectedReleaseAt', 'sandboxPaymentMethod', 'transactionReference', 'updatedAt'])
   )
   || (
   resource.data.orderStatus == 'pending'
   && resource.data.paymentStatus == 'unpaid'
   && resource.data.escrowStatus == 'notFunded'
   && request.resource.data.orderStatus == 'active'
   && request.resource.data.paymentStatus == 'demoPaid'
   && request.resource.data.escrowStatus == 'held'
   && request.resource.data.sandboxPaymentMethod is string
   && request.resource.data.sandboxPaymentMethod.size() > 0
   && request.resource.data.transactionReference is string
   && request.resource.data.transactionReference.size() > 0
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.clientId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.freelancerId == resource.data.freelancerId
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.status == 'held'
   && getAfter(
   /databases/$(database)/documents/serviceEscrows/$(orderId)
   ).data.amount == resource.data.totalAmount
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(resource.data.freelancerId)
   ).data.lastEscrowOrderId == orderId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['paymentStatus', 'escrowStatus', 'orderStatus', 'paidAt', 'escrowHeldAt', 'expectedReleaseAt', 'sandboxPaymentMethod', 'transactionReference', 'updatedAt'])
   )
   || (
   resource.data.orderStatus == 'delivered'
   && resource.data.paymentStatus == 'demoPaid'
   && resource.data.escrowStatus == 'held'
   && resource.data.deliveryStatus == 'submitted'
   && resource.data.lastDeliveryId is string
   && resource.data.lastDeliveryId.size() > 0
   && request.resource.data.orderStatus == 'completed'
   && request.resource.data.paymentStatus == 'released'
   && request.resource.data.escrowStatus == 'released'
   && request.resource.data.deliveryStatus == 'accepted'
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(resource.data.freelancerId)
   ).data.lastReleaseOrderId == orderId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['paymentStatus', 'escrowStatus', 'orderStatus', 'deliveryStatus', 'completedAt', 'escrowReleasedAt', 'updatedAt'])
   )
   );

   allow update: if isActiveUser()
   && resource.data.freelancerId == request.auth.uid
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.serviceRequestId == resource.data.serviceRequestId
   && (
   (
   resource.data.orderStatus == 'active'
   && resource.data.paymentStatus == 'demoPaid'
   && resource.data.escrowStatus == 'held'
   && request.resource.data.orderStatus == 'inProgress'
   && request.resource.data.deliveryStatus == 'pending'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['orderStatus', 'deliveryStatus', 'workStartedAt', 'updatedAt'])
   )
   || (
   resource.data.orderStatus == 'inProgress'
   && resource.data.paymentStatus == 'demoPaid'
   && resource.data.escrowStatus == 'held'
   && request.resource.data.orderStatus == 'delivered'
   && request.resource.data.deliveryStatus == 'submitted'
   && request.resource.data.lastDeliveryId is string
   && request.resource.data.lastDeliveryId.size() > 0
   && existsAfter(
   /databases/$(database)/documents/serviceOrders/$(orderId)/deliveries/$(request.resource.data.lastDeliveryId)
   )
   && getAfter(
   /databases/$(database)/documents/serviceOrders/$(orderId)/deliveries/$(request.resource.data.lastDeliveryId)
   ).data.orderId == orderId
   && getAfter(
   /databases/$(database)/documents/serviceOrders/$(orderId)/deliveries/$(request.resource.data.lastDeliveryId)
   ).data.clientId == resource.data.clientId
   && getAfter(
   /databases/$(database)/documents/serviceOrders/$(orderId)/deliveries/$(request.resource.data.lastDeliveryId)
   ).data.freelancerId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/serviceOrders/$(orderId)/deliveries/$(request.resource.data.lastDeliveryId)
   ).data.status == 'submitted'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['orderStatus', 'deliveryStatus', 'deliveredAt', 'reviewDueAt', 'lastDeliveryId', 'updatedAt'])
   )
   );

   allow update: if isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   )
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.serviceRequestId == resource.data.serviceRequestId
   && (
   (
   resource.data.orderStatus in ['active', 'delivered']
   && resource.data.paymentStatus == 'demoPaid'
   && resource.data.escrowStatus in ['held', 'disputed']
   && request.resource.data.revisionStatus == 'revisionRequested'
   && request.resource.data.revisionCount
   == resource.data.get('revisionCount', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['revisionCount', 'revisionStatus', 'revisionNotes', 'updatedAt'])
   )
   || (
   resource.data.orderStatus in ['active', 'delivered']
   && request.resource.data.revisionStatus in ['revisionAccepted', 'revisionSubmitted', 'revisionCompleted']
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['revisionStatus', 'revisionNotes', 'updatedAt'])
   )
   || (
   resource.data.orderStatus in ['active', 'delivered']
   && resource.data.paymentStatus == 'demoPaid'
   && resource.data.escrowStatus in ['held', 'disputed']
   && request.resource.data.orderStatus == 'disputed'
   && request.resource.data.escrowStatus in [
   resource.data.escrowStatus,
   'disputed'
   ]
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['orderStatus', 'escrowStatus', 'updatedAt'])
   )
   );

   allow update: if isAdmin()
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.serviceRequestId == resource.data.serviceRequestId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly([
   'paymentStatus', 'escrowStatus', 'orderStatus', 'revisionCount', 'revisionStatus', 'revisionNotes', 'completedAt', 'cancelledAt', 'escrowReleasedAt', 'refundedAt',
   'resolvedAt', 'settlementStatus', 'resolvedCaseId', 'demoSettlement', 'updatedAt'
   ]);

   allow delete: if false;
  }

  match /serviceOrders/{orderId}/deliveries/{deliveryId} {
   allow get, list: if isAdmin()
   || (
   signedIn()
   && exists(
   soPath(orderId)
   )
   && (
   soGet(orderId).clientId == request.auth.uid
   || soGet(orderId).freelancerId == request.auth.uid
   )
   );

   allow create: if isActiveUser()
   && request.resource.data.deliveryId == deliveryId
   && request.resource.data.orderId == orderId
   && request.resource.data.freelancerId == request.auth.uid
   && exists(
   soPath(orderId)
   )
   && soGet(orderId).freelancerId == request.auth.uid
   && request.resource.data.clientId == soGet(orderId).clientId
   && soGet(orderId).paymentStatus == 'demoPaid'
   && soGet(orderId).escrowStatus == 'held'
   && soGet(orderId).orderStatus == 'inProgress'
   && request.resource.data.status == 'submitted'
   && request.resource.data.message is string
   && request.resource.data.attachments is list
   && request.resource.data.attachments.size() <= 10
   && (
   request.resource.data.message.size() > 0
   || request.resource.data.attachments.size() > 0
   )
   && request.resource.data.keys().hasOnly(['deliveryId', 'orderId', 'clientId', 'freelancerId', 'message', 'attachments', 'status', 'submittedAt', 'updatedAt']);

   allow update, delete: if false;
  }

  match /invoices/{invoiceId} {
   allow get: if isAdmin()
   || (
   signedIn()
   && !exists(
   /databases/$(database)/documents/invoices/$(invoiceId)
   )
   )
   || (
   signedIn()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   )
   );

   allow list: if isAdmin()
   || (
   signedIn()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow create: if signedIn()
   && request.resource.data.invoiceId == invoiceId
   && request.resource.data.orderId is string
   && request.resource.data.orderId.size() > 0
   && request.resource.data.type in ['clientReceipt', 'freelancerInvoice', 'platformCommissionInvoice']
   && request.resource.data.status == 'paid'
   && (
   soAfter(request.resource.data.orderId).clientId == request.auth.uid
   || soAfter(request.resource.data.orderId).freelancerId == request.auth.uid
   )
   && request.resource.data.clientId == soAfter(request.resource.data.orderId).clientId
   && request.resource.data.freelancerId == soAfter(request.resource.data.orderId).freelancerId
   && request.resource.data.currency == soAfter(request.resource.data.orderId).currency
   && soAfter(request.resource.data.orderId).paymentStatus in ['demoPaid', 'released']
   && (
   (
   request.resource.data.type == 'clientReceipt'
   && invoiceId == request.resource.data.orderId + '_clientReceipt'
   && request.resource.data.subtotal == soAfter(request.resource.data.orderId).subtotal
   && request.resource.data.platformFee == soAfter(request.resource.data.orderId).platformFee
   && request.resource.data.taxAmount == soAfter(request.resource.data.orderId).taxTotal
   && request.resource.data.totalAmount == soAfter(request.resource.data.orderId).totalAmount
   )
   || (
   request.resource.data.type == 'freelancerInvoice'
   && invoiceId == request.resource.data.orderId + '_freelancerInvoice'
   && request.resource.data.subtotal == soAfter(request.resource.data.orderId).subtotal
   && request.resource.data.platformFee == soAfter(request.resource.data.orderId).platformFee
   && request.resource.data.taxAmount == soAfter(request.resource.data.orderId).taxTotal
   && request.resource.data.totalAmount == soAfter(request.resource.data.orderId).freelancerEarnings
   )
   || (
   request.resource.data.type == 'platformCommissionInvoice'
   && invoiceId == request.resource.data.orderId + '_platformCommissionInvoice'
   && request.resource.data.subtotal == soAfter(request.resource.data.orderId).platformFee
   && request.resource.data.platformFee == soAfter(request.resource.data.orderId).platformFee
   && request.resource.data.totalAmount == soAfter(request.resource.data.orderId).platformFee
   )
   );

   allow update, delete: if false;
  }

  match /serviceEscrows/{escrowId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/serviceEscrows/$(escrowId)
   )
   && exists(
   soPath(escrowId)
   )
   && soGet(escrowId).clientId == request.auth.uid
   )
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow create: if isActiveUser()
   && escrowId == request.resource.data.orderId
   && request.resource.data.escrowId == escrowId
   && request.resource.data.clientId == request.auth.uid
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && request.resource.data.status == 'held'
   && soAfter(escrowId).clientId == request.auth.uid
   && soAfter(escrowId).freelancerId == request.resource.data.freelancerId
   && soAfter(escrowId).paymentStatus == 'demoPaid'
   && soAfter(escrowId).escrowStatus == 'held'
   && soAfter(escrowId).totalAmount == request.resource.data.amount
   && soAfter(escrowId).currency == request.resource.data.currency;

   allow update: if isActiveUser()
   && resource.data.clientId == request.auth.uid
   && resource.data.status == 'held'
   && request.resource.data.status == 'released'
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.amount == resource.data.amount
   && request.resource.data.currency == resource.data.currency
   && request.resource.data.releasedAmount == resource.data.amount
   && request.resource.data.get('refundedAmount', 0) == resource.data.get('refundedAmount', 0)
   && soAfter(escrowId).clientId == request.auth.uid
   && soGet(escrowId).orderStatus == 'delivered'
   && soGet(escrowId).deliveryStatus == 'submitted'
   && soGet(escrowId).lastDeliveryId is string
   && soGet(escrowId).lastDeliveryId.size() > 0
   && soAfter(escrowId).escrowStatus == 'released'
   && soAfter(escrowId).paymentStatus == 'released'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'releasedAmount', 'refundedAmount', 'releasedAt', 'updatedAt']);

   allow update: if isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   )
   && resource.data.status == 'held'
   && request.resource.data.status == 'disputed'
   && soAfter(escrowId).orderStatus == 'disputed'
   && soAfter(escrowId).escrowStatus == 'disputed'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status']);

   allow update: if isAdmin()
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.amount == resource.data.amount
   && request.resource.data.currency == resource.data.currency
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'releasedAmount', 'refundedAmount', 'releasedAt', 'refundedAt', 'resolvedAt', 'updatedAt']);

   allow delete: if false;
  }

  match /commerceTransactions/{transactionId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/commerceTransactions/$(transactionId)
   )
   )
   || (
   isActiveUser()
   && (
   resource.data.userId == request.auth.uid
   || resource.data.walletId == request.auth.uid
   )
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.userId == request.auth.uid
   || resource.data.walletId == request.auth.uid
   )
   );

   allow create: if (isActiveUser() || isAdmin())
   && request.resource.data.transactionId == transactionId
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && (
   (
   transactionId == 'sandbox_escrow_hold_' + request.resource.data.orderId
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.type == 'escrowHold'
   && request.resource.data.status == 'pending'
   && soAfter(request.resource.data.orderId).clientId == request.auth.uid
   && soAfter(request.resource.data.orderId).paymentStatus == 'demoPaid'
   && soAfter(request.resource.data.orderId).escrowStatus == 'held'
   && soAfter(request.resource.data.orderId).totalAmount == request.resource.data.amount
   && soAfter(request.resource.data.orderId).currency == request.resource.data.currency
   )
   || (
   transactionId == 'sandbox_escrow_release_' + request.resource.data.orderId
   && request.resource.data.type == 'escrowRelease'
   && request.resource.data.status == 'pending'
   && soAfter(request.resource.data.orderId).clientId == request.auth.uid
   && soAfter(request.resource.data.orderId).freelancerId == request.resource.data.userId
   && soAfter(request.resource.data.orderId).escrowStatus == 'released'
   && soAfter(request.resource.data.orderId).freelancerEarnings == request.resource.data.amount
   )
   || (
   request.resource.data.type == 'walletClearance'
   && request.resource.data.status == 'cleared'
   && request.resource.data.userId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(request.auth.uid)
   ).data.pendingBalance == 0
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(request.auth.uid)
   ).data.lastClearanceReference == request.resource.data.referenceId
   )
   || (
   transactionId == 'sandbox_payout_request_' + request.resource.data.referenceId
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.walletId == request.auth.uid
   && request.resource.data.type == 'payoutRequest'
   && request.resource.data.status == 'pending'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.freelancerId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.status == 'pendingApproval'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.amount == request.resource.data.amount
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.currency == request.resource.data.currency
   )
   || (
   transactionId == 'sandbox_payout_cancelled_' + request.resource.data.referenceId
   && request.resource.data.userId == request.auth.uid
   && request.resource.data.walletId == request.auth.uid
   && request.resource.data.type == 'payoutCancelled'
   && request.resource.data.status == 'cleared'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.freelancerId == request.auth.uid
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.status == 'cancelled'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.amount == request.resource.data.amount
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.currency == request.resource.data.currency
   )
   || (
   isAdmin()
   && transactionId == 'sandbox_payout_paid_' + request.resource.data.referenceId
   && request.resource.data.type in ['withdrawal', 'payoutPaid']
   && request.resource.data.status == 'cleared'
   && request.resource.data.walletId == request.resource.data.userId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.status == 'paid'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.freelancerId == request.resource.data.userId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.amount == request.resource.data.amount
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.currency == request.resource.data.currency
   )
   || (
   isAdmin()
   && transactionId == 'sandbox_payout_rejected_' + request.resource.data.referenceId
   && request.resource.data.type == 'payoutRejected'
   && request.resource.data.status == 'cleared'
   && request.resource.data.walletId == request.resource.data.userId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.status == 'rejected'
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.freelancerId == request.resource.data.userId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.amount == request.resource.data.amount
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.referenceId)
   ).data.currency == request.resource.data.currency
   )
   || (
   isAdmin()
   && transactionId == 'sandbox_refund_' + request.resource.data.referenceId
   && request.resource.data.type == 'refund'
   && request.resource.data.status == 'cleared'
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.referenceId)
   ).data.status == 'processed'
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.referenceId)
   ).data.clientId == request.resource.data.userId
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.referenceId)
   ).data.amount == request.resource.data.amount
   )
   || (
   isAdmin()
   && transactionId == 'sandbox_escrow_release_' + request.resource.data.orderId
   && request.resource.data.type == 'escrowRelease'
   && request.resource.data.status == 'pending'
   && soAfter(request.resource.data.orderId).freelancerId == request.resource.data.userId
   && soAfter(request.resource.data.orderId).escrowStatus == 'released'
   )
   );

   allow update, delete: if false;
  }

  match /freelancerWallets/{freelancerId} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == freelancerId)
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/freelancerWallets/$(freelancerId)
   )
   );

   allow create: if (isActiveUser() || isAdmin())
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && (
   (
   request.auth.uid == freelancerId
   && request.resource.data.availableBalance == 0
   && request.resource.data.pendingBalance == 0
   && request.resource.data.escrowBalance == 0
   && request.resource.data.lifetimeEarnings == 0
   && request.resource.data.lifetimeWithdrawn == 0
   )
   || (
   isAdmin()
   && request.resource.data.availableBalance == 0
   && request.resource.data.pendingBalance > 0
   && request.resource.data.escrowBalance == 0
   && request.resource.data.pendingPayoutBalance == 0
   && request.resource.data.lifetimeEarnings == 0
   && request.resource.data.lifetimeWithdrawn == 0
   && request.resource.data.monthlyEarnings == 0
   && request.resource.data.weeklyEarnings == 0
   && request.resource.data.ordersThisMonth == 1
   && request.resource.data.keys().hasOnly([
   'walletId', 'freelancerId', 'availableBalance', 'pendingBalance', 'escrowBalance', 'pendingPayoutBalance', 'lifetimeEarnings', 'lifetimeWithdrawn', 'currency', 'monthlyEarnings',
   'weeklyEarnings', 'ordersThisMonth', 'updatedAt', 'createdAt'
   ])
   )
   || (
   request.resource.data.lastEscrowOrderId is string
   && request.resource.data.lastEscrowOrderId.size() > 0
   && soAfter(request.resource.data.lastEscrowOrderId).clientId == request.auth.uid
   && soAfter(request.resource.data.lastEscrowOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastEscrowOrderId).escrowStatus == 'held'
   && request.resource.data.escrowBalance == soAfter(request.resource.data.lastEscrowOrderId).totalAmount
   && request.resource.data.currency == soAfter(request.resource.data.lastEscrowOrderId).currency
   && request.resource.data.keys()
   .hasOnly(['walletId', 'freelancerId', 'currency', 'escrowBalance', 'lastEscrowOrderId', 'updatedAt'])
   )
   || (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).paymentStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).clientId == request.auth.uid
   && request.resource.data.availableBalance == 0
   && request.resource.data.pendingBalance == soAfter(request.resource.data.lastReleaseOrderId).freelancerEarnings
   && request.resource.data.escrowBalance == 0
   && request.resource.data.pendingPayoutBalance == 0
   && request.resource.data.lifetimeEarnings == 0
   && request.resource.data.lifetimeWithdrawn == 0
   && request.resource.data.monthlyEarnings == 0
   && request.resource.data.weeklyEarnings == 0
   && request.resource.data.ordersThisMonth == 1
   && request.resource.data.currency == soAfter(request.resource.data.lastReleaseOrderId).currency
   && request.resource.data.keys().hasOnly([
   'walletId', 'freelancerId', 'availableBalance', 'pendingBalance', 'escrowBalance', 'pendingPayoutBalance', 'lifetimeEarnings', 'lifetimeWithdrawn', 'currency', 'monthlyEarnings',
   'weeklyEarnings', 'ordersThisMonth', 'lastReleaseOrderId', 'updatedAt'
   ])
   )
   || (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).paymentStatus == 'released'
   && (
   isAdmin()
   || soAfter(request.resource.data.lastReleaseOrderId).clientId == request.auth.uid
   )
   && request.resource.data.availableBalance == 0
   && request.resource.data.escrowBalance == 0
   && request.resource.data.pendingBalance == soAfter(request.resource.data.lastReleaseOrderId).freelancerEarnings
   && request.resource.data.pendingPayoutBalance == 0
   && request.resource.data.lifetimeEarnings == 0
   && request.resource.data.lifetimeWithdrawn == 0
   && request.resource.data.monthlyEarnings == 0
   && request.resource.data.weeklyEarnings == 0
   && request.resource.data.ordersThisMonth == 1
   )
   || (
   isAdmin()
   && request.resource.data.lastRefundId is string
   && request.resource.data.lastRefundId.size() > 0
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.status == 'processed'
   && request.resource.data.availableBalance == 0
   && request.resource.data.escrowBalance == 0
   && request.resource.data.pendingPayoutBalance == 0
   && request.resource.data.lifetimeEarnings == 0
   && request.resource.data.lifetimeWithdrawn == 0
   && request.resource.data.monthlyEarnings == 0
   && request.resource.data.weeklyEarnings == 0
   && (
   (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && request.resource.data.pendingBalance >= 0
   && request.resource.data.ordersThisMonth == 1
   )
   || (
   request.resource.data.pendingBalance == 0
   && request.resource.data.ordersThisMonth == 0
   )
   )
   )
   );

   allow update: if isActiveUser()
   && resource.data.walletId == freelancerId
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && (
   (
   request.resource.data.lastEscrowOrderId is string
   && request.resource.data.lastEscrowOrderId.size() > 0
   && soAfter(request.resource.data.lastEscrowOrderId).clientId == request.auth.uid
   && soAfter(request.resource.data.lastEscrowOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastEscrowOrderId).escrowStatus == 'held'
   && request.resource.data.escrowBalance == resource.data.escrowBalance + soAfter(request.resource.data.lastEscrowOrderId).totalAmount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['currency', 'escrowBalance', 'lastEscrowOrderId', 'updatedAt'])
   )
   || (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).clientId == request.auth.uid
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).paymentStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).orderStatus == 'completed'
   && request.resource.data.currency == resource.data.get('currency', 'USD')
   && request.resource.data.currency == soAfter(request.resource.data.lastReleaseOrderId).currency
   && request.resource.data.availableBalance == resource.data.get('availableBalance', 0)
   && request.resource.data.pendingBalance == resource.data.get('pendingBalance', 0) + soAfter(request.resource.data.lastReleaseOrderId).freelancerEarnings
   && request.resource.data.escrowBalance == resource.data.get('escrowBalance', 0)
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0)
   && request.resource.data.lifetimeEarnings == resource.data.get('lifetimeEarnings', 0)
   && request.resource.data.lifetimeWithdrawn == resource.data.get('lifetimeWithdrawn', 0)
   && request.resource.data.monthlyEarnings == resource.data.get('monthlyEarnings', 0)
   && request.resource.data.weeklyEarnings == resource.data.get('weeklyEarnings', 0)
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly([
   'walletId', 'freelancerId', 'availableBalance', 'pendingBalance', 'escrowBalance', 'pendingPayoutBalance', 'lifetimeEarnings', 'lifetimeWithdrawn', 'currency', 'monthlyEarnings',
   'weeklyEarnings', 'ordersThisMonth', 'lastReleaseOrderId', 'updatedAt'
   ])
   )
   || (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).clientId == request.auth.uid
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && request.resource.data.pendingBalance == resource.data.get('pendingBalance', 0) + soAfter(request.resource.data.lastReleaseOrderId).freelancerEarnings
   && request.resource.data.escrowBalance == resource.data.get('escrowBalance', 0) - soAfter(request.resource.data.lastReleaseOrderId).totalAmount
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'currency', 'escrowBalance', 'pendingBalance', 'ordersThisMonth', 'lastReleaseOrderId', 'updatedAt'])
   )
   || (
   request.auth.uid == freelancerId
   && resource.data.pendingBalance > 0
   && request.resource.data.pendingBalance == 0
   && request.resource.data.availableBalance == resource.data.availableBalance + resource.data.pendingBalance
   && request.resource.data.lifetimeEarnings == resource.data.lifetimeEarnings + resource.data.pendingBalance
   && request.resource.data.monthlyEarnings == resource.data.monthlyEarnings + resource.data.pendingBalance
   && request.resource.data.weeklyEarnings == resource.data.weeklyEarnings + resource.data.pendingBalance
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['pendingBalance', 'availableBalance', 'lifetimeEarnings', 'monthlyEarnings', 'weeklyEarnings', 'lastClearanceReference', 'updatedAt'])
   )
   || (
   request.auth.uid == freelancerId
   && request.resource.data.activePayoutId is string
   && request.resource.data.activePayoutId.size() > 0
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.status == 'pendingApproval'
   && request.resource.data.availableBalance == resource.data.get('availableBalance', 0) - getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.amount
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0) + getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'pendingPayoutBalance', 'activePayoutId', 'updatedAt', 'walletId', 'freelancerId'])
   )
   || (
   request.auth.uid == freelancerId
   && request.resource.data.lastPayoutId is string
   && request.resource.data.lastPayoutId.size() > 0
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.status == 'cancelled'
   && request.resource.data.availableBalance == resource.data.availableBalance + getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0) - getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'pendingPayoutBalance', 'activePayoutId', 'lastPayoutId', 'updatedAt'])
   )
   || (
   isAdmin()
   && request.resource.data.lastPayoutId is string
   && request.resource.data.lastPayoutId.size() > 0
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.status == 'rejected'
   && request.resource.data.availableBalance == resource.data.availableBalance + getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0) - getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'pendingPayoutBalance', 'activePayoutId', 'lastPayoutId', 'updatedAt'])
   )
   || (
   isAdmin()
   && request.resource.data.lastPayoutId is string
   && request.resource.data.lastPayoutId.size() > 0
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.status == 'paid'
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0) - getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.lifetimeWithdrawn == resource.data.lifetimeWithdrawn + getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['pendingPayoutBalance', 'lifetimeWithdrawn', 'activePayoutId', 'lastPayoutId', 'updatedAt'])
   )
   || (
   request.resource.data.lastRefundId is string
   && request.resource.data.lastRefundId.size() > 0
   && request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.status == 'processed'
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && request.resource.data.escrowBalance == resource.data.escrowBalance - soAfter(request.resource.data.lastReleaseOrderId).totalAmount
   && request.resource.data.pendingBalance >= resource.data.get('pendingBalance', 0)
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'escrowBalance', 'pendingBalance', 'ordersThisMonth', 'lastRefundId', 'lastReleaseOrderId', 'updatedAt'])
   )
   );

   // Freelancer sandbox payout reserve: allow even when legacy/top-up wallets
   // omit walletId/freelancerId on the existing document (client heals them).
   allow update: if isActiveUser()
   && request.auth.uid == freelancerId
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && request.resource.data.activePayoutId is string
   && request.resource.data.activePayoutId.size() > 0
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.status == 'pendingApproval'
   && request.resource.data.availableBalance == resource.data.get('availableBalance', 0) - getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.amount
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0) + getAfter(
   /databases/$(database)/documents/payouts/$(request.resource.data.activePayoutId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'pendingPayoutBalance', 'activePayoutId', 'updatedAt', 'walletId', 'freelancerId']);

   allow update: if isAdmin()
   && resource.data.walletId == freelancerId
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && (
   (
   request.resource.data.lastRefundId is string
   && request.resource.data.lastRefundId.size() > 0
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.status == 'processed'
   && request.resource.data.escrowBalance == resource.data.escrowBalance - getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.amount
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'escrowBalance', 'lastRefundId', 'updatedAt'])
   )
   || (
   request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && request.resource.data.escrowBalance == resource.data.escrowBalance - soAfter(request.resource.data.lastReleaseOrderId).totalAmount
   && request.resource.data.pendingBalance == resource.data.get('pendingBalance', 0) + soAfter(request.resource.data.lastReleaseOrderId).freelancerEarnings
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'currency', 'escrowBalance', 'pendingBalance', 'ordersThisMonth', 'lastReleaseOrderId', 'updatedAt'])
   )
   || (
   request.resource.data.lastRefundId is string
   && request.resource.data.lastRefundId.size() > 0
   && request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.status == 'processed'
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.freelancerId == freelancerId
   && getAfter(
   /databases/$(database)/documents/refunds/$(request.resource.data.lastRefundId)
   ).data.orderId == request.resource.data.lastReleaseOrderId
   && soAfter(request.resource.data.lastReleaseOrderId).freelancerId == freelancerId
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && request.resource.data.escrowBalance == resource.data.escrowBalance - soAfter(request.resource.data.lastReleaseOrderId).totalAmount
   && request.resource.data.pendingBalance >= resource.data.get('pendingBalance', 0)
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'escrowBalance', 'pendingBalance', 'ordersThisMonth', 'lastRefundId', 'lastReleaseOrderId', 'updatedAt'])
   )
   );

   allow update: if isAdmin()
   && resource.data.walletId == freelancerId
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && request.resource.data.currency == resource.data.currency
   && request.resource.data.availableBalance == resource.data.availableBalance
   && request.resource.data.pendingBalance > resource.data.pendingBalance
   && request.resource.data.escrowBalance == resource.data.escrowBalance
   && request.resource.data.pendingPayoutBalance == resource.data.pendingPayoutBalance
   && request.resource.data.lifetimeEarnings == resource.data.lifetimeEarnings
   && request.resource.data.lifetimeWithdrawn == resource.data.lifetimeWithdrawn
   && request.resource.data.monthlyEarnings == resource.data.monthlyEarnings
   && request.resource.data.weeklyEarnings == resource.data.weeklyEarnings
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['pendingBalance', 'ordersThisMonth', 'updatedAt']);

   allow update: if isAdmin()
   && request.resource.data.walletId == freelancerId
   && request.resource.data.freelancerId == freelancerId
   && request.resource.data.currency is string
   && request.resource.data.availableBalance == resource.data.get('availableBalance', 0)
   && request.resource.data.pendingBalance > resource.data.get('pendingBalance', 0)
   && request.resource.data.escrowBalance == resource.data.get('escrowBalance', 0)
   && request.resource.data.pendingPayoutBalance == resource.data.get('pendingPayoutBalance', 0)
   && request.resource.data.lifetimeEarnings == resource.data.get('lifetimeEarnings', 0)
   && request.resource.data.lifetimeWithdrawn == resource.data.get('lifetimeWithdrawn', 0)
   && request.resource.data.monthlyEarnings == resource.data.get('monthlyEarnings', 0)
   && request.resource.data.weeklyEarnings == resource.data.get('weeklyEarnings', 0)
   && request.resource.data.ordersThisMonth == resource.data.get('ordersThisMonth', 0) + 1
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['walletId', 'freelancerId', 'currency', 'pendingBalance', 'ordersThisMonth', 'updatedAt']);

   allow delete: if false;
  }

  match /payouts/{payoutId} {
   // Allow get on missing docs so requestPayout can transaction.get() the
   // new payout id before create (same pattern as commerceTransactions).
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/payouts/$(payoutId)
   )
   )
   || (
   isActiveUser()
   && resource.data.freelancerId == request.auth.uid
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && resource.data.freelancerId == request.auth.uid
   );

   allow create: if isActiveUser()
   && request.resource.data.payoutId == payoutId
   && request.resource.data.freelancerId == request.auth.uid
   && request.resource.data.walletId == request.auth.uid
   && request.resource.data.amount is number
   && request.resource.data.amount >= 25
   && request.resource.data.amount <= 10000
   && request.resource.data.status == 'pendingApproval'
   && request.resource.data.destinationType in ['Sandbox Bank', 'Sandbox Stripe', 'Sandbox PayPal', 'Future Custom']
   && request.resource.data.destinationName is string
   && request.resource.data.destinationName.size() > 0
   && request.resource.data.destinationMasked is string
   && request.resource.data.destinationMasked.size() > 0
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(request.auth.uid)
   ).data.activePayoutId == payoutId
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(request.auth.uid)
   ).data.pendingPayoutBalance >= request.resource.data.amount;

   allow update: if isAdmin()
   && request.resource.data.payoutId == resource.data.payoutId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.walletId == resource.data.walletId
   && request.resource.data.amount == resource.data.amount
   && request.resource.data.currency == resource.data.currency
   && request.resource.data.destinationType == resource.data.destinationType
   && request.resource.data.destinationName == resource.data.destinationName
   && request.resource.data.destinationMasked == resource.data.destinationMasked
   && (
   (
   resource.data.status == 'pendingApproval'
   && request.resource.data.status == 'approved'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt', 'notes'])
   )
   || (
   resource.data.status == 'approved'
   && request.resource.data.status == 'processing'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'processedAt', 'processedBy', 'updatedAt', 'notes'])
   )
   || (
   resource.data.status in ['pendingApproval', 'approved', 'processing']
   && request.resource.data.status == 'rejected'
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(resource.data.freelancerId)
   ).data.lastPayoutId == payoutId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'completedAt', 'rejectedAt', 'rejectedBy', 'updatedAt', 'notes'])
   )
   || (
   resource.data.status in ['approved', 'processing']
   && request.resource.data.status == 'paid'
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(resource.data.freelancerId)
   ).data.lastPayoutId == payoutId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'processedAt', 'completedAt', 'paidAt', 'paidBy', 'updatedAt'])
   )
   );

   allow update: if isActiveUser()
   && resource.data.freelancerId == request.auth.uid
   && resource.data.walletId == request.auth.uid
   && resource.data.status == 'pendingApproval'
   && request.resource.data.status == 'cancelled'
   && request.resource.data.payoutId == resource.data.payoutId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.walletId == resource.data.walletId
   && request.resource.data.amount == resource.data.amount
   && request.resource.data.currency == resource.data.currency
   && request.resource.data.destinationType == resource.data.destinationType
   && request.resource.data.destinationName == resource.data.destinationName
   && request.resource.data.destinationMasked == resource.data.destinationMasked
   && getAfter(
   /databases/$(database)/documents/freelancerWallets/$(request.auth.uid)
   ).data.lastPayoutId == payoutId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'completedAt', 'cancelledAt', 'updatedAt', 'notes']);

   allow delete: if false;
  }

  match /revisionRequests/{revisionId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/revisionRequests/$(revisionId)
   )
   )
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow create: if isActiveUser()
   && request.resource.data.revisionId == revisionId
   && request.resource.data.orderId is string
   && request.resource.data.orderId.size() > 0
   && request.resource.data.requestedBy == request.auth.uid
   && exists(
   soPath(request.resource.data.orderId)
   )
   && (
   soGet(request.resource.data.orderId).clientId == request.auth.uid
   || soGet(request.resource.data.orderId).freelancerId == request.auth.uid
   )
   && request.resource.data.clientId == soGet(request.resource.data.orderId).clientId
   && request.resource.data.freelancerId == soGet(request.resource.data.orderId).freelancerId
   && request.resource.data.status == 'revisionRequested';

   allow update: if (
   isActiveUser()
   && resource.data.freelancerId == request.auth.uid
   && request.resource.data.status in ['revisionAccepted', 'revisionSubmitted']
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'freelancerResponse', 'submissionNotes', 'submittedBy', 'acceptedAt', 'submittedAt', 'updatedAt'])
   )
   || (
   isActiveUser()
   && resource.data.clientId == request.auth.uid
   && request.resource.data.status == 'revisionCompleted'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'clientCompletionNote', 'completedAt', 'updatedAt'])
   );

   allow delete: if false;
  }

  match /disputes/{disputeId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/disputes/$(disputeId)
   )
   )
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow create: if isActiveUser()
   && request.resource.data.disputeId == disputeId
   && request.resource.data.orderId is string
   && request.resource.data.orderId.size() > 0
   && request.resource.data.openedBy == request.auth.uid
   && request.resource.data.status == 'open'
   && exists(
   soPath(request.resource.data.orderId)
   )
   && (
   soGet(request.resource.data.orderId).clientId == request.auth.uid
   || soGet(request.resource.data.orderId).freelancerId == request.auth.uid
   );

   allow update: if (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   )
   && request.resource.data.status == 'evidenceSubmitted'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'evidence', 'updatedAt'])
   )
   || (
   isAdmin()
   && request.resource.data.status == 'resolved'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'decision', 'resolutionNotes', 'refundAmount', 'resolvedBy', 'resolvedAt', 'updatedAt'])
   );

   allow delete: if false;
  }

  match /refunds/{refundId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/refunds/$(refundId)
   )
   )
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.clientId == request.auth.uid
   || resource.data.freelancerId == request.auth.uid
   || (
   resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && (
   soGet(resource.data.orderId).clientId == request.auth.uid
   || soGet(resource.data.orderId).freelancerId == request.auth.uid
   )
   )
   )
   );

   allow create: if (
   isActiveUser()
   && request.resource.data.refundId == refundId
   && request.resource.data.clientId == request.auth.uid
   && request.resource.data.requestedBy == request.auth.uid
   && request.resource.data.status == 'pendingReview'
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && exists(
   soPath(request.resource.data.orderId)
   )
   && soGet(request.resource.data.orderId).clientId == request.auth.uid
   )
   || (
   isAdmin()
   && request.resource.data.refundId == refundId
   && request.resource.data.status == 'processed'
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && exists(
   soPath(request.resource.data.orderId)
   )
   );

   allow update: if isAdmin()
   && request.resource.data.refundId == resource.data.refundId
   && request.resource.data.orderId == resource.data.orderId
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.amount == resource.data.amount
   && (
   (
   resource.data.status == 'pendingReview'
   && request.resource.data.status == 'approved'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'approvedBy', 'approvedAt', 'adminNotes', 'updatedAt'])
   )
   || (
   resource.data.status in ['pendingReview', 'approved']
   && request.resource.data.status == 'rejected'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'rejectedBy', 'rejectedAt', 'adminNotes', 'updatedAt'])
   )
   || (
   resource.data.status == 'approved'
   && request.resource.data.status == 'processed'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'processedBy', 'processedAt', 'adminNotes', 'updatedAt', 'createdAt'])
   )
   );

   allow delete: if false;
  }

  match /commissionLedger/{commissionId} {
   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/commissionLedger/$(commissionId)
   )
   );

   allow list: if isAdmin();

   allow create: if isActiveUser()
   && commissionId == 'sandbox_commission_' + request.resource.data.orderId
   && request.resource.data.commissionId == commissionId
   && request.resource.data.source == 'freelancerService'
   && request.resource.data.status == 'pending'
   && request.resource.data.amount is number
   && request.resource.data.amount >= 0
   && soAfter(request.resource.data.orderId).clientId == request.auth.uid
   && soAfter(request.resource.data.orderId).paymentStatus == 'demoPaid'
   && soAfter(request.resource.data.orderId).escrowStatus == 'held'
   && soAfter(request.resource.data.orderId).platformFee == request.resource.data.amount
   && soAfter(request.resource.data.orderId).currency == request.resource.data.currency;

   allow update, delete: if false;
  }

  match /serviceReviews/{reviewId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && exists(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   )
   && (
   get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.clientId == request.auth.uid
   || get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.freelancerId == request.auth.uid
   )
   )
   || (
   exists(
   /databases/$(database)/documents/serviceReviews/$(reviewId)
   )
   && resource.data.isVisible == true
   );

   allow create: if isActiveUser()
   && request.resource.data.reviewId == reviewId
   && request.resource.data.serviceRequestId == reviewId
   && request.resource.data.clientId == request.auth.uid
   && request.resource.data.rating is int
   && request.resource.data.rating >= 1
   && request.resource.data.rating <= 5
   && request.resource.data.isVisible == true
   && exists(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   )
   && get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.status == 'completed'
   && get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.clientId == request.auth.uid
   && get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.freelancerId != request.auth.uid
   && request.resource.data.serviceId == get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.serviceId
   && request.resource.data.freelancerId == get(
   /databases/$(database)/documents/serviceRequests/$(reviewId)
   ).data.freelancerId;

   allow update: if isAdmin()
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['isVisible', 'updatedAt']);

   allow delete: if false;
  }

  match /contactMessages/{messageId} {
   allow create: if request.resource.data.get('messageId', messageId)
   == messageId
   && request.resource.data.get('status', 'new') == 'new'
   && request.resource.data.get('priority', 'normal') in ['low', 'normal', 'high']
   && (
   !signedIn()
   || request.resource.data.get('userId', request.auth.uid)
   == request.auth.uid
   );

   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.get('userId', '') == request.auth.uid
   );

   allow update: if isAdmin()
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'priority', 'adminNote', 'adminResponse', 'respondedBy', 'respondedAt', 'resolvedBy', 'resolvedAt', 'updatedAt']);

   allow delete: if isAdmin();
  }

  match /companies/{uid} {
   allow read: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
   allow create: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.get('verificationStatus', 'pending')
   == 'pending'
   );
   allow update: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == uid
   && request.resource.data.get('verificationStatus', 'pending')
   == resource.data.get('verificationStatus', 'pending')
   );
   allow delete: if isAdmin()
   || (isActiveUser() && request.auth.uid == uid);
  }

  match /jobs/{jobId} {
   allow read: if true;

   allow create: if hasRole('company')
   && request.resource.data.companyId == request.auth.uid
   && companyIsVerified();

   allow update: if hasRole('company')
   && resource.data.companyId == request.auth.uid
   && request.resource.data.companyId == request.auth.uid
   && companyIsVerified();

   allow delete: if hasRole('company')
   && resource.data.companyId == request.auth.uid;
  }

  match /courses/{courseId} {
   allow read: if resource.data.status == 'published'
   || resource.data.isPublished == true
   || isAdmin()
   || isEnrolled(courseId)
   || (
   hasRole('teacher')
   && resource.data.teacherId == request.auth.uid
   );

   allow create: if hasRole('teacher')
   && request.resource.data.teacherId == request.auth.uid
   && request.resource.data.status in ['draft', 'published', 'archived'];

   allow update: if hasRole('teacher')
   && resource.data.teacherId == request.auth.uid
   && request.resource.data.teacherId == resource.data.teacherId
   && request.resource.data.status in ['draft', 'published', 'archived'];

   allow delete: if false;

   match /lessons/{lessonId} {
    allow read: if isAdmin()
    || courseIsPublished(courseId)
    || isEnrolled(courseId)
    || ownsCourse(courseId);

    allow create: if ownsCourse(courseId)
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid;

    allow update: if ownsCourse(courseId)
    && resource.data.courseId == courseId
    && resource.data.teacherId == request.auth.uid
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid;

    allow delete: if false;
   }

   match /assignments/{assignmentId} {
    allow get: if isAdmin()
    || ownsCourse(courseId)
    || (
    isEnrolled(courseId)
    && resource.data.type in ['mcq', 'project']
    && resource.data.status == 'published'
    );
    allow list: if isAdmin()
    || ownsCourse(courseId)
    || isEnrolled(courseId);

    allow create: if ownsCourse(courseId)
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid
    && request.resource.data.type in ['mcq', 'project']
    && request.resource.data.status in ['draft', 'published', 'archived'];

    allow update: if ownsCourse(courseId)
    && resource.data.courseId == courseId
    && resource.data.teacherId == request.auth.uid
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid
    && request.resource.data.type in ['mcq', 'project']
    && request.resource.data.status in ['draft', 'published', 'archived'];

    allow delete: if false;

    match /attempts/{studentId} {
     allow read: if isAdmin()
     || ownsCourse(courseId)
     || (
     hasRole('student')
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     );

     allow create, update: if hasRole('student')
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     && get(
     /databases/$(database)/documents/courses/$(courseId)/assignments/$(assignmentId)
     ).data.status == 'published'
     && request.resource.data.studentId == request.auth.uid
     && request.resource.data.courseId == courseId
     && request.resource.data.assignmentId == assignmentId;

     allow delete: if false;
    }

    match /submissions/{studentId} {
     allow read: if isAdmin()
     || ownsCourse(courseId)
     || (
     hasRole('student')
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     );

     allow create: if hasRole('student')
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     && get(
     /databases/$(database)/documents/courses/$(courseId)/assignments/$(assignmentId)
     ).data.status == 'published'
     && request.resource.data.studentId == request.auth.uid
     && request.resource.data.courseId == courseId
     && request.resource.data.assignmentId == assignmentId;

     allow update: if (
     (
     hasRole('student')
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     && request.resource.data.studentId == request.auth.uid
     && request.resource.data.courseId == courseId
     && request.resource.data.assignmentId == assignmentId
     )
     || (
     ownsCourse(courseId)
     && resource.data.courseId == courseId
     && resource.data.assignmentId == assignmentId
     && request.resource.data.courseId == courseId
     && request.resource.data.assignmentId == assignmentId
     && request.resource.data.studentId == resource.data.studentId
     )
     );

     allow delete: if false;
    }
   }

   match /grandTests/{grandTestId} {
    allow get: if isAdmin()
    || ownsCourse(courseId)
    || (
    isEnrolled(courseId)
    && resource.data.status == 'published'
    );
    allow list: if isAdmin()
    || ownsCourse(courseId)
    || isEnrolled(courseId);

    allow create: if ownsCourse(courseId)
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid
    && request.resource.data.status in ['draft', 'published', 'archived'];

    allow update: if ownsCourse(courseId)
    && resource.data.courseId == courseId
    && resource.data.teacherId == request.auth.uid
    && request.resource.data.courseId == courseId
    && request.resource.data.teacherId == request.auth.uid
    && request.resource.data.status in ['draft', 'published', 'archived'];

    allow delete: if false;

    match /eligibility/{studentId} {
     allow read: if isAdmin()
     || ownsCourse(courseId)
     || (
     signedIn()
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     );

     allow create, update: if isAdmin()
     || ownsCourse(courseId)
     || (
     signedIn()
     && request.auth.uid == studentId
     && isEnrolled(courseId)
     );

     allow delete: if false;
    }

    match /attempts/{attemptId} {
     allow read: if isAdmin()
     || ownsCourse(courseId)
     || (
     signedIn()
     && resource.data.studentId == request.auth.uid
     && isEnrolled(courseId)
     );

     allow create: if signedIn()
     && isEnrolled(courseId)
     && get(
     /databases/$(database)/documents/courses/$(courseId)/grandTests/$(grandTestId)
     ).data.status == 'published'
     && request.resource.data.studentId == request.auth.uid
     && request.resource.data.courseId == courseId
     && request.resource.data.grandTestId == grandTestId
     && request.resource.data.status == 'in_progress';

     allow update: if signedIn()
     && isEnrolled(courseId)
     && resource.data.studentId == request.auth.uid
     && resource.data.courseId == courseId
     && resource.data.grandTestId == grandTestId
     && resource.data.status == 'in_progress'
     && request.resource.data.studentId == resource.data.studentId
     && request.resource.data.courseId == resource.data.courseId
     && request.resource.data.grandTestId == resource.data.grandTestId
     && request.resource.data.status in ['in_progress', 'submitted', 'auto_submitted'];

     allow delete: if false;
    }
   }
  }

  match /enrollments/{enrollmentId} {
   allow create: if hasRole('student')
   && request.resource.data.studentId == request.auth.uid
   && request.resource.data.courseId is string
   && request.resource.data.teacherId is string
   && request.resource.data.status in ['active', 'completed', 'dropped']
   && courseIsPublished(request.resource.data.courseId)
   && courseIsFreeToEnroll(request.resource.data.courseId)
   && get(coursePath(request.resource.data.courseId)).data.teacherId
   == request.resource.data.teacherId;

   allow get: if isAdmin()
   || (
   isActiveUser()
   && !exists(
   /databases/$(database)/documents/enrollments/$(enrollmentId)
   )
   )
   || (
   hasRole('student')
   && resource.data.studentId == request.auth.uid
   )
   || (
   hasRole('teacher')
   && (
   resource.data.teacherId == request.auth.uid
   || ownsCourse(resource.data.courseId)
   )
   );

   allow list: if isAdmin()
   || (
   hasRole('student')
   && resource.data.studentId == request.auth.uid
   )
   || (
   hasRole('teacher')
   && (
   resource.data.teacherId == request.auth.uid
   || ownsCourse(resource.data.courseId)
   )
   );

   allow update: if hasRole('student')
   && resource.data.studentId == request.auth.uid
   && request.resource.data.studentId == resource.data.studentId
   && request.resource.data.courseId == resource.data.courseId
   && request.resource.data.teacherId == resource.data.teacherId
   && request.resource.data.status in ['active', 'completed', 'dropped'];

   allow delete: if false;

   match /lessonProgress/{lessonId} {
    allow read: if isAdmin()
    || (
    hasRole('student')
    && get(
    /databases/$(database)/documents/enrollments/$(enrollmentId)
    ).data.studentId == request.auth.uid
    )
    || (
    hasRole('teacher')
    && get(
    /databases/$(database)/documents/enrollments/$(enrollmentId)
    ).data.teacherId == request.auth.uid
    );

    allow create, update: if hasRole('student')
    && get(
    /databases/$(database)/documents/enrollments/$(enrollmentId)
    ).data.studentId == request.auth.uid
    && request.resource.data.studentId == request.auth.uid
    && request.resource.data.lessonId == lessonId;

    allow delete: if false;
   }
  }

  match /certificates/{certificateId} {
   allow get: if isAdmin()
   || (
   hasRole('teacher')
   && !exists(
   /databases/$(database)/documents/certificates/$(certificateId)
   )
   )
   || (
   isActiveUser()
   && resource.data.get('studentId', '') == request.auth.uid
   )
   || (
   hasRole('teacher')
   && (
   resource.data.get('teacherId', '') == request.auth.uid
   || ownsCourse(resource.data.get('courseId', ''))
   )
   )
   || (
   hasRole('company')
   && resource.data.get('status', 'active') == 'active'
   && hasBoundHiringCandidateAccess(resource.data.get('studentId', ''))
   );

   allow list: if isAdmin()
   || (
   isActiveUser()
   && resource.data.get('studentId', '') == request.auth.uid
   )
   || (
   hasRole('teacher')
   && (
   resource.data.get('teacherId', '') == request.auth.uid
   || ownsCourse(resource.data.get('courseId', ''))
   )
   )
   || (
   hasRole('company')
   && resource.data.get('status', 'active') == 'active'
   && hasBoundHiringCandidateAccess(resource.data.get('studentId', ''))
   );

   allow create: if isAdmin()
   || (
   hasRole('teacher')
   && request.resource.data.get('certificateId', certificateId)
   == certificateId
   && request.resource.data.get('teacherId', '') == request.auth.uid
   && request.resource.data.get('studentId', '') is string
   && request.resource.data.get('courseId', '') is string
   && request.resource.data.get('status', 'active') == 'active'
   && ownsCourse(request.resource.data.get('courseId', ''))
   );

   allow update: if isAdmin()
   || (
   hasRole('teacher')
   && (
   resource.data.get('teacherId', '') == request.auth.uid
   || ownsCourse(resource.data.get('courseId', ''))
   )
   && request.resource.data.get('teacherId', '')
   == resource.data.get('teacherId', '')
   && request.resource.data.get('studentId', '')
   == resource.data.get('studentId', '')
   && request.resource.data.get('courseId', '')
   == resource.data.get('courseId', '')
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'revokedAt', 'revokeReason'])
   && request.resource.data.get('status', '') == 'revoked'
   );

   allow delete: if false;
  }

  match /skillScores/{studentId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   )
   || hasRole('teacher')
   || hasBoundHiringCandidateAccess(studentId);

   allow create, update: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   );
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   );

   match /skills/{skillId} {
    allow read: if isAdmin()
    || (
    isActiveUser()
    && request.auth.uid == studentId
    )
    || hasRole('teacher')
    || hasBoundHiringCandidateAccess(studentId);

    allow create, update: if isAdmin()
    || (
    isActiveUser()
    && request.auth.uid == studentId
    && request.resource.data.get('studentId', studentId) == studentId
    );
    allow delete: if isAdmin()
    || (
    isActiveUser()
    && request.auth.uid == studentId
    );
   }
  }

  match /smartResumes/{studentId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   )
   || hasBoundHiringCandidateAccess(studentId);

   allow create, update: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   && request.resource.data.get('studentId', studentId) == studentId
   );
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && request.auth.uid == studentId
   );
  }

  match /applications/{applicationId} {
   allow create: if (
   hasRole('student') || hasRole('freelancer')
   )
   && request.resource.data.applicantId == request.auth.uid
   && exists(
   jobPath(request.resource.data.jobId)
   )
   && get(
   jobPath(request.resource.data.jobId)
   ).data.isActive == true
   && request.resource.data.companyId
   == get(
   jobPath(request.resource.data.jobId)
   ).data.companyId
   && request.resource.data.status in ['Pending', 'applied'];

   allow read: if isAdmin()
   || (
   (hasRole('student') || hasRole('freelancer'))
   && resource.data.applicantId == request.auth.uid
   )
   || (
   hasRole('company')
   && (
   resource.data.companyId == request.auth.uid
   || ownsJob(resource.data.jobId)
   )
   );

   allow update: if isAdmin()
   || (
   hasRole('company')
   && (
   resource.data.companyId == request.auth.uid
   || ownsJob(resource.data.jobId)
   )
   && request.resource.data.companyId == resource.data.companyId
   && request.resource.data.jobId == resource.data.jobId
   && request.resource.data.applicantId == resource.data.applicantId
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly([
   'status', 'interviewId', 'lastUpdatedAt', 'pipelineStage', 'evaluationScore', 'evaluationSummary', 'rankingScore', 'rankingReason', 'matchedSkills', 'missingSkills',
   'recommendedNextStep', 'companyNotes', 'offerStatus', 'offerDetails', 'candidateVisibleStatus', 'evaluationRequestStatus', 'evaluationQuestions', 'offerSalary', 'offerCurrency', 'offerJoiningDate',
   'offerMessage', 'offerSentAt', 'talentPoolSaved', 'evaluatedAt', 'lifecycleStage', 'employmentStatus', 'joinedAt', 'offerRole', 'offerDepartment', 'offerEmploymentType',
   'offerBenefits', 'offerContractDuration', 'offerWorkingHours', 'offerLocation', 'offerExpiresAt', 'hrInterviewFeedback', 'hrHiringComments', 'onboardingChecklist', 'offerDocumentGeneratedAt', 'welcomePack', 'employmentProfile', 'probation', 'offboarding', 'documents', 'hrThreadId', 'lastJoinReminderAt', 'lastDocsReminderAt'
   ])
   )
   || (
   (hasRole('student') || hasRole('freelancer'))
   && resource.data.applicantId == request.auth.uid
   && request.resource.data.companyId == resource.data.companyId
   && request.resource.data.jobId == resource.data.jobId
   && request.resource.data.applicantId == resource.data.applicantId
   && resource.data.offerStatus in ['sent', 'viewed', 'pending', 'clarification']
   && request.resource.data.offerStatus in ['accepted', 'declined', 'clarification']
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['offerStatus', 'candidateVisibleStatus', 'candidateResponseMessage', 'offerRespondedAt', 'lastUpdatedAt', 'lifecycleStage', 'employmentStatus', 'onboardingChecklist'])
    || ((hasRole('student') || hasRole('freelancer')) && resource.data.applicantId == request.auth.uid && request.resource.data.companyId == resource.data.companyId && request.resource.data.jobId == resource.data.jobId && request.resource.data.applicantId == resource.data.applicantId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerDocumentGeneratedAt','lastUpdatedAt'])) || ((hasRole('student') || hasRole('freelancer')) && resource.data.applicantId == request.auth.uid && resource.data.employmentStatus in ['joining_soon','active'] && request.resource.data.companyId == resource.data.companyId && request.resource.data.jobId == resource.data.jobId && request.resource.data.applicantId == resource.data.applicantId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingChecklist','documents','hrThreadId','lastJoinReminderAt','lastDocsReminderAt','lastUpdatedAt','offerDocumentGeneratedAt'])));

   allow update: if (
   hasRole('student') || hasRole('freelancer')
   )
   && resource.data.applicantId == request.auth.uid
   && request.resource.data.companyId == resource.data.companyId
   && request.resource.data.jobId == resource.data.jobId
   && request.resource.data.applicantId == resource.data.applicantId
   && resource.data.evaluationRequestStatus == 'requested'
   && request.resource.data.evaluationRequestStatus == 'submitted'
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['evaluationAnswers', 'evaluationRequestStatus', 'evaluationSubmittedAt', 'candidateVisibleStatus', 'lifecycleStage', 'lastUpdatedAt']);

   allow delete: if isAdmin();

   match /timeline/{eventId} {
    allow read: if isAdmin()
    || (
    (hasRole('student') || hasRole('freelancer'))
    && exists(applicationPath(applicationId))
    && get(applicationPath(applicationId)).data.applicantId
    == request.auth.uid
    )
    || (
    hasRole('company')
    && exists(applicationPath(applicationId))
    && (
    get(applicationPath(applicationId)).data.companyId
    == request.auth.uid
    || ownsJob(get(applicationPath(applicationId)).data.jobId)
    )
    );

    allow create: if signedIn()
    && (
    (
    hasRole('company')
    && request.resource.data.companyId == request.auth.uid
    && exists(applicationPath(applicationId))
    && (
    get(applicationPath(applicationId)).data.companyId
    == request.auth.uid
    || ownsJob(get(applicationPath(applicationId)).data.jobId)
    )
    )
    || (
    (hasRole('student') || hasRole('freelancer'))
    && request.resource.data.candidateId == request.auth.uid
    && exists(applicationPath(applicationId))
    && get(applicationPath(applicationId)).data.applicantId
    == request.auth.uid
    )
    );

    allow update, delete: if isAdmin();
   }
  }

  match /candidate_employment/{applicantId} {
   allow read: if signedIn()
   && (
   request.auth.uid == applicantId
   || isAdmin()
   || hasRole('company')
   );

   allow create: if signedIn()
   && request.resource.data.applicantId == applicantId
   && request.resource.data.applicationId is string
   && request.resource.data.companyId is string
   && request.resource.data.status in ['joining_soon', 'active']
   && (
   request.auth.uid == applicantId
   || (
   hasRole('company')
   && request.resource.data.companyId == request.auth.uid
   && ownsApplication(request.resource.data.applicationId)
   )
   );

   allow update: if signedIn()
   && request.resource.data.applicantId == applicantId
   && request.resource.data.applicationId is string
   && request.resource.data.companyId is string
   && request.resource.data.status in ['joining_soon', 'active']
   && (
   request.auth.uid == applicantId
   || (
   hasRole('company')
   && request.resource.data.companyId == request.auth.uid
   && ownsApplication(request.resource.data.applicationId)
   )
   || (
   hasRole('company')
   && resource.data.companyId == request.auth.uid
   && request.resource.data.companyId == resource.data.companyId
   && request.resource.data.applicationId == resource.data.applicationId
   && ownsApplication(resource.data.applicationId)
   )
   );

   allow delete: if signedIn()
   && (
   request.auth.uid == applicantId
   || isAdmin()
   || (
   hasRole('company')
   && resource.data.companyId == request.auth.uid
   )
   );
  }

  match /interviews/{interviewId} {
   allow read: if isAdmin()
   || (
   (hasRole('student') || hasRole('freelancer'))
   && resource.data.candidateId == request.auth.uid
   )
   || (
   hasRole('company')
   && (
   resource.data.companyId == request.auth.uid
   || ownsApplication(resource.data.applicationId)
   || ownsJob(resource.data.jobId)
   )
   );

   allow create: if hasRole('company')
   && request.resource.data.companyId == request.auth.uid
   && exists(
   applicationPath(request.resource.data.applicationId)
   )
   && get(
   applicationPath(request.resource.data.applicationId)
   ).data.companyId == request.auth.uid;

   allow update: if hasRole('company')
   && (
   resource.data.companyId == request.auth.uid
   || ownsApplication(resource.data.applicationId)
   || ownsJob(resource.data.jobId)
   )
   && request.resource.data.companyId == resource.data.companyId
   && request.resource.data.applicationId == resource.data.applicationId
   && request.resource.data.jobId == resource.data.jobId
   && request.resource.data.candidateId == resource.data.candidateId;

   allow delete: if false;
  }

  match /admins/{uid} {
   allow get: if isAdmin()
   || (signedIn() && request.auth.uid == uid);
   allow list: if signedIn();
   allow write: if isAdmin();
  }

  match /platform_settings/{document=**} {
   allow read: if true;
   allow write: if isAdmin();
  }

  match /customerWallets/{customerId} {
   function isWalletOwner() {
    return signedIn() && customerId == request.auth.uid;
   }

   function immutableCustomerWalletFieldsUnchanged() {
    return request.resource.data.walletId == resource.data.walletId
    && request.resource.data.customerId == resource.data.customerId
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.createdAt == resource.data.createdAt;
   }

   allow read: if isAdmin() || isWalletOwner();

   allow create: if isWalletOwner()
   && request.resource.data.walletId == request.auth.uid
   && request.resource.data.customerId == request.auth.uid
   && request.resource.data.currency == 'USD'
   && request.resource.data.availableBalance == 0
   && request.resource.data.totalAdded == 0
   && request.resource.data.totalSpent == 0
   && request.resource.data.totalRefunded == 0
   && request.resource.data.totalEscrowed == 0
   && request.resource.data.status == 'active'
   && request.resource.data.keys().hasOnly([
   'walletId', 'customerId', 'currency', 'availableBalance', 'totalAdded', 'totalSpent', 'totalRefunded', 'totalEscrowed', 'createdAt', 'updatedAt',
   'status'
   ]);

   allow create: if isAdmin()
   && request.resource.data.walletId == customerId
   && request.resource.data.customerId == customerId
   && request.resource.data.currency is string
   && request.resource.data.availableBalance >= 0
   && request.resource.data.totalAdded == 0
   && request.resource.data.totalSpent == 0
   && request.resource.data.totalRefunded == request.resource.data.availableBalance
   && request.resource.data.totalEscrowed == 0
   && request.resource.data.status == 'active'
   && request.resource.data.keys().hasOnly([
   'walletId', 'customerId', 'currency', 'availableBalance', 'totalAdded', 'totalSpent', 'totalRefunded', 'totalEscrowed', 'createdAt', 'updatedAt',
   'status'
   ]);

   allow update: if isWalletOwner()
   && resource.data.status == 'active'
   && immutableCustomerWalletFieldsUnchanged()
   && request.resource.data.status == resource.data.status
   && request.resource.data.totalAdded == resource.data.totalAdded
   && request.resource.data.totalRefunded == resource.data.totalRefunded
   && request.resource.data.availableBalance < resource.data.availableBalance
   && request.resource.data.totalSpent > resource.data.totalSpent
   && request.resource.data.totalEscrowed > resource.data.totalEscrowed
   && resource.data.availableBalance - request.resource.data.availableBalance
   == request.resource.data.totalSpent - resource.data.totalSpent
   && resource.data.availableBalance - request.resource.data.availableBalance
   == request.resource.data.totalEscrowed - resource.data.totalEscrowed
   && request.resource.data.availableBalance >= 0
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'totalSpent', 'totalEscrowed', 'updatedAt']);

   allow update: if isWalletOwner()
   && resource.data.status == 'active'
   && immutableCustomerWalletFieldsUnchanged()
   && request.resource.data.status == resource.data.status
   && request.resource.data.totalAdded == resource.data.totalAdded
   && request.resource.data.totalSpent == resource.data.totalSpent
   && request.resource.data.totalRefunded == resource.data.totalRefunded
   && request.resource.data.availableBalance == resource.data.availableBalance
   && request.resource.data.lastReleaseOrderId is string
   && request.resource.data.lastReleaseOrderId.size() > 0
   && soAfter(request.resource.data.lastReleaseOrderId).clientId == request.auth.uid
   && soAfter(request.resource.data.lastReleaseOrderId).paymentStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).escrowStatus == 'released'
   && soAfter(request.resource.data.lastReleaseOrderId).orderStatus == 'completed'
   && resource.data.totalEscrowed - request.resource.data.totalEscrowed
   == soAfter(request.resource.data.lastReleaseOrderId).totalAmount
   && request.resource.data.totalEscrowed >= 0
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['totalEscrowed', 'lastReleaseOrderId', 'updatedAt']);

   allow update: if isAdmin()
   && request.resource.data.walletId == resource.data.walletId
   && request.resource.data.customerId == resource.data.customerId
   && request.resource.data.status in ['active', 'frozen']
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'updatedAt']);

   allow update: if isAdmin()
   && resource.data.status == 'active'
   && immutableCustomerWalletFieldsUnchanged()
   && request.resource.data.status == resource.data.status
   && request.resource.data.totalAdded == resource.data.totalAdded
   && request.resource.data.totalSpent == resource.data.totalSpent
   && request.resource.data.availableBalance >= resource.data.availableBalance
   && request.resource.data.totalRefunded >= resource.data.totalRefunded
   && request.resource.data.totalEscrowed <= resource.data.totalEscrowed
   && request.resource.data.totalEscrowed >= 0
   && request.resource.data.availableBalance - resource.data.availableBalance
   == request.resource.data.totalRefunded - resource.data.totalRefunded
   && resource.data.totalEscrowed - request.resource.data.totalEscrowed > 0
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['availableBalance', 'totalRefunded', 'totalEscrowed', 'updatedAt']);

   allow delete: if false;
  }

  match /walletTransactions/{transactionId} {
   function isTransactionOwner() {
    return signedIn() && resource.data.ownerId == request.auth.uid;
   }

   allow get: if signedIn()
   && !exists(
   /databases/$(database)/documents/walletTransactions/$(transactionId)
   );

   allow read: if isAdmin()
   || isTransactionOwner()
   || (
   signedIn()
   && resource.data.type == 'escrowRelease'
   && resource.data.orderId is string
   && exists(
   soPath(resource.data.orderId)
   )
   && soGet(resource.data.orderId).clientId == request.auth.uid
   );

   allow create: if signedIn()
   && request.resource.data.transactionId == transactionId
   && request.resource.data.ownerId == request.auth.uid
   && request.resource.data.ownerType == 'customer'
   && request.resource.data.walletId == request.auth.uid
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && request.resource.data.description is string
   && request.resource.data.status == 'completed'
   && (
   (
   request.resource.data.type in ['orderPayment', 'escrowHold']
   && request.resource.data.direction == 'debit'
   && request.resource.data.orderId is string
   && transactionId == 'wallet_order_payment_' + request.resource.data.orderId
   && request.resource.data.referenceId is string
   && request.resource.data.referenceId.size() > 0
   && soAfter(request.resource.data.orderId).clientId == request.auth.uid
   && soAfter(request.resource.data.orderId).paymentStatus == 'demoPaid'
   && soAfter(request.resource.data.orderId).escrowStatus == 'held'
   && soAfter(request.resource.data.orderId).totalAmount == request.resource.data.amount
   && soAfter(request.resource.data.orderId).currency == request.resource.data.currency
   && request.resource.data.keys().hasOnly([
   'transactionId', 'ownerId', 'ownerType', 'walletId', 'type', 'direction', 'amount', 'currency', 'status', 'orderId',
   'referenceId', 'description', 'createdAt', 'updatedAt'
   ])
   )
   );

   allow create: if isAdmin()
   && request.resource.data.transactionId == transactionId
   && request.resource.data.demoMode == true
   && request.resource.data.createdBy == request.auth.uid
   && request.resource.data.type in ['demoResolutionRelease', 'demoResolutionRefund', 'demoResolutionSplit']
   && request.resource.data.direction in ['credit', 'debit', 'holdReleased']
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && request.resource.data.caseId is string
   && request.resource.data.orderId is string
   && request.resource.data.userId is string
   && request.resource.data.ownerId == request.resource.data.userId
   && request.resource.data.walletId == request.resource.data.userId
   && request.resource.data.ownerType in ['customer', 'freelancer']
   && request.resource.data.role in ['customer', 'freelancer']
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.status == 'resolved'
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.demoSettlement == true
   && request.resource.data.keys().hasOnly([
   'transactionId', 'userId', 'ownerId', 'ownerType', 'role', 'walletId', 'amount', 'currency', 'type', 'direction',
   'status', 'demoMode', 'caseId', 'orderId', 'createdBy', 'createdAt', 'updatedAt'
   ]);

   allow create: if signedIn()
   && request.resource.data.transactionId == transactionId
   && request.resource.data.ownerId is string
   && request.resource.data.ownerId.size() > 0
   && request.resource.data.ownerType == 'freelancer'
   && request.resource.data.walletId == request.resource.data.ownerId
   && request.resource.data.type == 'escrowRelease'
   && request.resource.data.direction == 'credit'
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && request.resource.data.currency is string
   && request.resource.data.status == 'completed'
   && request.resource.data.orderId is string
   && transactionId == 'wallet_order_release_' + request.resource.data.orderId
   && soAfter(request.resource.data.orderId).clientId == request.auth.uid
   && soGet(request.resource.data.orderId).orderStatus == 'delivered'
   && soGet(request.resource.data.orderId).deliveryStatus == 'submitted'
   && soGet(request.resource.data.orderId).lastDeliveryId is string
   && soGet(request.resource.data.orderId).lastDeliveryId.size() > 0
   && soAfter(request.resource.data.orderId).freelancerId == request.resource.data.ownerId
   && soAfter(request.resource.data.orderId).paymentStatus == 'released'
   && soAfter(request.resource.data.orderId).escrowStatus == 'released'
   && soAfter(request.resource.data.orderId).orderStatus == 'completed'
   && soAfter(request.resource.data.orderId).freelancerEarnings == request.resource.data.amount
   && soAfter(request.resource.data.orderId).currency == request.resource.data.currency
   && request.resource.data.keys().hasOnly([
   'transactionId', 'ownerId', 'ownerType', 'walletId', 'type', 'direction', 'amount', 'currency', 'status', 'orderId',
   'description', 'createdAt', 'updatedAt'
   ]);

   allow create: if isAdmin()
   && request.resource.data.transactionId == transactionId
   && request.resource.data.ownerId is string
   && request.resource.data.ownerId.size() > 0
   && request.resource.data.ownerType in ['customer', 'freelancer']
   && request.resource.data.walletId == request.resource.data.ownerId
   && request.resource.data.type in ['refund', 'splitRefund', 'escrowRelease']
   && request.resource.data.direction == 'credit'
   && request.resource.data.amount is number
   && request.resource.data.amount > 0
   && request.resource.data.currency is string
   && request.resource.data.status == 'completed'
   && request.resource.data.orderId is string
   && request.resource.data.orderId.size() > 0
   && request.resource.data.caseId is string
   && request.resource.data.caseId.size() > 0
   && exists(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   )
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.status == 'resolved'
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.orderId == request.resource.data.orderId
   && (
   (
   request.resource.data.ownerType == 'customer'
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.clientId == request.resource.data.ownerId
   )
   || (
   request.resource.data.ownerType == 'freelancer'
   && getAfter(
   /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId)
   ).data.freelancerId == request.resource.data.ownerId
   )
   )
   && request.resource.data.keys().hasOnly([
   'transactionId', 'ownerId', 'ownerType', 'walletId', 'type', 'direction', 'amount', 'currency', 'status', 'orderId',
   'caseId', 'description', 'createdAt', 'updatedAt'
   ]);

   allow update, delete: if false;
  }

  match /logs/{document=**} {
   allow read, create: if isAdmin();
   allow update, delete: if false;
  }

  match /skillforgeLaws/{lawId} {
   allow read: if isAdmin() || resource.data.isActive == true;
   allow create, update: if isAdmin()
   && request.resource.data.lawId == lawId
   && request.resource.data.caseType in ['refund', 'dispute', 'revision', 'autoRelease']
   && request.resource.data.requiredEvidence in ['none', 'client', 'freelancer', 'both']
   && request.resource.data.isActive is bool
   && request.resource.data.keys().hasOnly([
   'lawId', 'title', 'description', 'caseType', 'appliesWhen', 'requiredEvidence', 'clientRights', 'freelancerRights', 'adminAllowedActions', 'defaultRecommendation',
   'priority', 'isActive', 'version', 'createdAt', 'updatedAt', 'updatedBy'
   ]);
   allow delete: if false;
  }

  match /resolutionCases/{caseId} {
   function isResolutionParticipant(data) {
    return signedIn()
    && (
    data.clientId == request.auth.uid
    || data.freelancerId == request.auth.uid
    );
   }

   function casePath() {
    return /databases/$(database)/documents/resolutionCases/$(caseId);
   }

   function linkedOrderPath(data) {
    return soPath(data.orderId);
   }

   function linkedOrderMatches(data) {
    return data.orderId is string
    && exists(linkedOrderPath(data))
    && get(linkedOrderPath(data)).data.clientId == data.clientId
    && get(linkedOrderPath(data)).data.freelancerId == data.freelancerId
    && get(linkedOrderPath(data)).data.serviceRequestId == data.serviceRequestId
    && get(linkedOrderPath(data)).data.serviceId == data.serviceId;
   }

   function actorOwnsLinkedOrder(data) {
    return linkedOrderMatches(data)
    && (
    get(linkedOrderPath(data)).data.clientId == request.auth.uid
    || get(linkedOrderPath(data)).data.freelancerId == request.auth.uid
    );
   }

   function validCaseType(value) {
    return value in ['revision', 'dispute', 'refund'];
   }

   function validCaseStatus(value) {
    return value in [
    'draft', 'open', 'revisionRequested', 'revisionAccepted', 'revisionSubmitted', 'revisionCompleted', 'evidenceRequested', 'underReview', 'resolved', 'rejected',
    'cancelled'
    ];
   }

   function validDecision(value) {
    return value in ['none', 'releaseToFreelancer', 'refundToClient', 'splitRelease', 'rejectRequest'];
   }

   function validSettlementStatus(value) {
    return value in ['none', 'pending', 'rejected', 'recorded', 'completed', 'failed'];
   }

   function validPriority(value) {
    return value in ['low', 'normal', 'high', 'urgent'];
   }

   function validRequestedByRole(value) {
    return value in ['customer', 'client', 'freelancer'];
   }

   allow get: if signedIn() && !exists(casePath());

   allow create: if signedIn()
   && request.resource.data.caseId == caseId
   && request.resource.data.requestedBy == request.auth.uid
   && request.resource.data.openedBy == request.resource.data.requestedBy
   && request.resource.data.openedByRole == request.resource.data.requestedByRole
   && request.resource.data.evidenceRequired is bool
   && request.resource.data.clientEvidence is list
   && request.resource.data.freelancerEvidence is list
   && request.resource.data.orderSnapshot is map
   && (
   request.resource.data.clientId == request.auth.uid
   || request.resource.data.freelancerId == request.auth.uid
   )
   && actorOwnsLinkedOrder(request.resource.data)
   && validCaseType(request.resource.data.type)
   && validCaseStatus(request.resource.data.status)
   && validRequestedByRole(request.resource.data.requestedByRole)
   && validPriority(request.resource.data.priority)
   && request.resource.data.resolutionDecision == 'none'
   && validSettlementStatus(request.resource.data.settlementStatus)
   && request.resource.data.settlementStatus in ['none', 'pending']
   && request.resource.data.releaseAmount == 0
   && request.resource.data.refundAmount == 0
   && request.resource.data.requestedRefundAmount >= 0
   && (
   request.resource.data.type == 'refund'
   || (
   get(linkedOrderPath(request.resource.data)).data.orderStatus == 'delivered'
   && get(linkedOrderPath(request.resource.data)).data.deliveryStatus == 'submitted'
   && get(linkedOrderPath(request.resource.data)).data.lastDeliveryId is string
   && get(linkedOrderPath(request.resource.data)).data.lastDeliveryId.size() > 0
   )
   )
   && request.resource.data.keys().hasAll([
   'caseId', 'orderId', 'serviceRequestId', 'serviceId', 'serviceTitle', 'clientId', 'clientName', 'freelancerId', 'freelancerName', 'type',
   'status', 'requestedBy', 'requestedByRole', 'openedBy', 'openedByRole', 'againstUserId', 'reason', 'description', 'clientNotes', 'freelancerNotes',
   'adminNotes', 'evidenceUrls', 'resolutionDecision', 'requestedRefundAmount', 'releaseAmount', 'refundAmount', 'currency', 'priority', 'isFinancialSettlementRequired', 'settlementStatus',
   'evidenceRequired', 'relatedDeliveryIds', 'clientEvidenceCount', 'freelancerEvidenceCount', 'evidenceRequestStatus', 'clientEvidence', 'freelancerEvidence', 'aiRecommendationStatus', 'aiSummary', 'aiRecommendedAction',
   'adminFindings', 'orderSnapshot', 'createdAt', 'updatedAt'
   ])
   && request.resource.data.keys().hasOnly([
   'caseId', 'orderId', 'serviceRequestId', 'serviceId', 'serviceTitle', 'clientId', 'clientName', 'freelancerId', 'freelancerName', 'type',
   'status', 'requestedBy', 'requestedByRole', 'openedBy', 'openedByRole', 'againstUserId', 'againstRole', 'relatedRefundCaseId', 'relatedDisputeCaseId', 'latestDeliveryId',
   'relatedDeliveryIds', 'reason', 'description', 'clientNotes', 'freelancerNotes', 'adminNotes', 'evidenceUrls', 'resolutionDecision', 'requestedRefundAmount', 'releaseAmount',
   'refundAmount', 'currency', 'priority', 'isFinancialSettlementRequired', 'settlementStatus', 'evidenceRequired', 'clientEvidenceCount', 'freelancerEvidenceCount', 'adminEvidenceRequestedFrom', 'evidenceRequestStatus',
   'clientEvidence', 'freelancerEvidence', 'lawId', 'lawTitle', 'aiRecommendationStatus', 'aiSummary', 'aiRecommendedAction', 'adminFindings', 'orderSnapshot', 'createdAt',
   'updatedAt'
   ])
   && !(request.resource.data.keys().hasAny(['assignedAdminId', 'legacyDisputeId', 'legacyRevisionId', 'legacyRefundId', 'resolvedAt', 'closedAt']));

   allow read: if isAdmin() || isResolutionParticipant(resource.data);

   allow update: if isResolutionParticipant(resource.data)
   && request.resource.data.caseId == resource.data.caseId
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.orderId == resource.data.orderId
   && validCaseStatus(request.resource.data.status)
   && request.resource.data.resolutionDecision == resource.data.resolutionDecision
   && request.resource.data.settlementStatus == resource.data.settlementStatus
   && linkedOrderMatches(resource.data)
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'clientNotes', 'freelancerNotes', 'evidenceUrls', 'clientEvidenceCount', 'freelancerEvidenceCount', 'evidenceRequestStatus', 'updatedAt', 'closedAt'])
   && (
   request.resource.data.status == resource.data.status
   || request.resource.data.status in ['revisionAccepted', 'revisionSubmitted', 'revisionCompleted', 'evidenceRequested']
   );

   allow update: if isAdmin()
   && request.resource.data.caseId == resource.data.caseId
   && request.resource.data.clientId == resource.data.clientId
   && request.resource.data.freelancerId == resource.data.freelancerId
   && request.resource.data.orderId == resource.data.orderId
   && validCaseStatus(request.resource.data.status)
   && validDecision(request.resource.data.resolutionDecision)
   && validSettlementStatus(request.resource.data.settlementStatus)
   && linkedOrderMatches(resource.data)
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly([
   'assignedAdminId', 'status', 'adminNotes', 'adminFindings', 'evidenceRequestStatus', 'adminEvidenceRequestedFrom', 'adminEvidenceRequestMessage', 'lawId', 'lawTitle', 'aiRecommendationStatus',
   'aiSummary', 'aiRecommendedAction', 'resolutionType', 'decisionNote', 'resolvedBy', 'demoSettlement', 'demoSettlementStatus', 'resolutionDecision', 'releaseAmount', 'refundAmount',
   'settlementStatus', 'isFinancialSettlementRequired', 'resolvedAt', 'closedAt', 'updatedAt'
   ]);

   allow delete: if false;

   match /events/{eventId} {
    function parentCasePath() {
     return /databases/$(database)/documents/resolutionCases/$(caseId);
    }

    allow read: if isAdmin()
    || (
    signedIn()
    && exists(parentCasePath())
    && (
    get(parentCasePath()).data.clientId == request.auth.uid
    || get(parentCasePath()).data.freelancerId == request.auth.uid
    )
    );

    function validResolutionEventType(value) {
     return value in [
     'caseCreated', 'revisionAccepted', 'revisionSubmitted', 'revisionCompleted', 'evidenceAdded', 'commentAdded', 'adminComment', 'statusChanged', 'evidenceRequested', 'decisionMade',
     'settlementRecorded', 'caseClosed', 'caseRejected'
     ];
    }

    allow create: if signedIn()
    && request.resource.data.eventId == eventId
    && request.resource.data.caseId == caseId
    && request.resource.data.actorId == request.auth.uid
    && validResolutionEventType(request.resource.data.eventType)
    && request.resource.data.actorRole in ['customer', 'client', 'freelancer', 'admin']
    && request.resource.data.keys().hasOnly(['eventId', 'caseId', 'actorId', 'actorRole', 'eventType', 'message', 'metadata', 'createdAt'])
    && (
    isAdmin()
    || (
    exists(parentCasePath())
    && (
    get(parentCasePath()).data.clientId == request.auth.uid
    || get(parentCasePath()).data.freelancerId == request.auth.uid
    )
    )
    || (
    getAfter(parentCasePath()).data.caseId == caseId
    && (
    getAfter(parentCasePath()).data.clientId == request.auth.uid
    || getAfter(parentCasePath()).data.freelancerId == request.auth.uid
    )
    )
    );

    allow update, delete: if false;
   }

   match /evidence/{evidenceId} {
    function parentCasePath() {
     return /databases/$(database)/documents/resolutionCases/$(caseId);
    }

    allow read: if isAdmin()
    || (
    signedIn()
    && exists(parentCasePath())
    && (
    get(parentCasePath()).data.clientId == request.auth.uid
    || get(parentCasePath()).data.freelancerId == request.auth.uid
    )
    );

    allow create: if signedIn()
    && request.resource.data.evidenceId == evidenceId
    && request.resource.data.caseId == caseId
    && request.resource.data.actorId == request.auth.uid
    && request.resource.data.actorRole in ['client', 'freelancer', 'admin']
    && request.resource.data.title is string
    && request.resource.data.description is string
    && request.resource.data.attachments is list
    && request.resource.data.keys().hasOnly(['evidenceId', 'caseId', 'actorId', 'actorRole', 'title', 'description', 'attachments', 'relatedDeliveryId', 'createdAt'])
    && (
    isAdmin()
    || (
    exists(parentCasePath())
    && (
    get(parentCasePath()).data.clientId == request.auth.uid
    || get(parentCasePath()).data.freelancerId == request.auth.uid
    )
    )
    );

    allow update, delete: if false;
   }
  }

  match /resolutionSettlements/{settlementId} {
   function linkedCasePath() {
    return /databases/$(database)/documents/resolutionCases/$(request.resource.data.caseId);
   }

   function readLinkedCasePath() {
    return /databases/$(database)/documents/resolutionCases/$(resource.data.caseId);
   }

   allow create: if isAdmin()
   && request.resource.data.settlementId == settlementId
   && request.resource.data.demoMode == true
   && request.resource.data.createdBy == request.auth.uid
   && request.resource.data.type in ['demoRelease', 'demoRefund', 'demoSplit']
   && request.resource.data.freelancerAmount is number
   && request.resource.data.customerAmount is number
   && request.resource.data.platformAmount is number
   && request.resource.data.totalAmount is number
   && request.resource.data.freelancerAmount >= 0
   && request.resource.data.customerAmount >= 0
   && request.resource.data.totalAmount == request.resource.data.freelancerAmount + request.resource.data.customerAmount
   && request.resource.data.status == 'completed'
   && getAfter(linkedCasePath()).data.status == 'resolved'
   && getAfter(linkedCasePath()).data.demoSettlement == true
   && request.resource.data.keys().hasOnly([
   'settlementId', 'caseId', 'orderId', 'serviceRequestId', 'clientId', 'freelancerId', 'type', 'demoMode', 'totalAmount', 'freelancerAmount',
   'customerAmount', 'platformAmount', 'currency', 'status', 'createdBy', 'createdAt', 'updatedAt'
   ]);

   allow create: if isAdmin()
   && request.resource.data.settlementId == settlementId
   && request.resource.data.recordedBy == request.auth.uid
   && request.resource.data.releaseAmount is number
   && request.resource.data.refundAmount is number
   && request.resource.data.totalAmount is number
   && request.resource.data.releaseAmount >= 0
   && request.resource.data.refundAmount >= 0
   && request.resource.data.totalAmount == request.resource.data.releaseAmount + request.resource.data.refundAmount
   && request.resource.data.status in ['recorded', 'completed', 'failed']
   && request.resource.data.keys().hasOnly([
   'settlementId', 'caseId', 'orderId', 'serviceRequestId', 'clientId', 'freelancerId', 'type', 'releaseAmount', 'refundAmount', 'totalAmount',
   'currency', 'status', 'recordedBy', 'recordedAt', 'createdAt', 'updatedAt'
   ])
   && getAfter(linkedCasePath()).data.status == 'resolved'
   && getAfter(linkedCasePath()).data.resolutionDecision in ['releaseToFreelancer', 'refundToClient', 'splitRelease'];

   allow read: if isAdmin()
   || (
   signedIn()
   && exists(readLinkedCasePath())
   && (
   get(readLinkedCasePath()).data.clientId == request.auth.uid
   || get(readLinkedCasePath()).data.freelancerId == request.auth.uid
   )
   );

   allow update: if isAdmin()
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['status', 'updatedAt']);

   allow delete: if false;
  }

  match /adminAuditLogs/{logId} {
   allow read: if isAdmin();
   allow create: if isAdmin()
   && request.resource.data.adminId == request.auth.uid
   && request.resource.data.demoMode == true
   && request.resource.data.action is string
   && request.resource.data.caseId is string
   && request.resource.data.orderId is string
   && request.resource.data.keys().hasOnly(['action', 'caseId', 'orderId', 'before', 'after', 'adminId', 'demoMode', 'createdAt']);
   allow update, delete: if false;
  }

  match /emailEvents/{eventId} {
   allow read: if isAdmin()
   || (
   signedIn()
   && resource.data.triggeredBy == request.auth.uid
   );
   allow create: if signedIn()
   && request.resource.data.toEmail is string
   && request.resource.data.type is string
   && request.resource.data.status in ['pending', 'sent', 'failed', 'skipped']
   && request.resource.data.triggeredBy == request.auth.uid
   && request.resource.data.dedupeKey is string
   && request.resource.data.keys().hasOnly(['toEmail', 'toName', 'type', 'relatedDocPath', 'status', 'errorMessage', 'createdAt', 'sentAt', 'triggeredBy', 'dedupeKey']);
   allow update, delete: if false;
  }

  match /plans/{planId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /subscriptions/{subscriptionId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.userId == request.auth.uid
   || resource.data.teacherId == request.auth.uid
   )
   );
   allow create, update, delete: if isAdmin();
  }

  match /teacher_entitlements/{entitlementId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.teacherId == request.auth.uid
   );
   allow create, update, delete: if isAdmin();
  }

  match /transactions/{transactionId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.userId == request.auth.uid
   );
   allow create, update, delete: if isAdmin();
  }

  match /paymentIntents/{intentId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.userId == request.auth.uid
   );
   allow create, update, delete: if isAdmin();
  }

  match /payments/{paymentId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.userId == request.auth.uid
   || resource.data.teacherId == request.auth.uid
   )
   );
   allow create, update, delete: if isAdmin();
  }

  match /credit_packs/{packId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /saved_payment_methods/{methodId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.userId == request.auth.uid
   );
   allow create: if isActiveUser()
   && request.resource.data.userId == request.auth.uid;
   allow update, delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.userId == request.auth.uid
   );
  }

  match /paid_courses/{courseId} {
   allow read: if true; // Public - all can see pricing
   allow create, update: if isAdmin()
   || (
   hasRole('teacher')
   && exists(/databases/$(database)/documents/courses/$(courseId))
   && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid
   );
   allow delete: if isAdmin();
  }

  match /course_purchases/{purchaseId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && (
   resource.data.studentId == request.auth.uid
   || resource.data.teacherId == request.auth.uid
   )
   );
   allow create, update, delete: if isAdmin();
  }

  match /interview_templates/{templateId} {
   allow read: if isActiveUser() || isAdmin();
   allow write: if isAdmin();
  }

  match /interview_sessions/{sessionId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(resource.data.candidateId);
   allow create: if isActiveUser()
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.sessionId == sessionId
   && request.resource.data.module == 'interview_lab';
   allow update: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   && request.resource.data.candidateId == resource.data.candidateId
   && request.resource.data.module == 'interview_lab'
   );
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
  }

  match /interview_questions/{questionId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && exists(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId))
   && get(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId)).data.candidateId
   == request.auth.uid
   )
   || (
   exists(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId))
   && hasBoundHiringCandidateAccess(
   get(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId)).data.candidateId
   )
   );
   allow create: if isActiveUser()
   && request.resource.data.module == 'interview_lab'
   && exists(/databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId))
   && get(/databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId)).data.candidateId
   == request.auth.uid;
   allow update: if isAdmin()
   || (
   isActiveUser()
   && exists(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId))
   && get(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId)).data.candidateId
   == request.auth.uid
   && request.resource.data.sessionId == resource.data.sessionId
   );
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && exists(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId))
   && get(/databases/$(database)/documents/interview_sessions/$(resource.data.sessionId)).data.candidateId
   == request.auth.uid
   );
  }

  match /interview_reports/{reportId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(resource.data.candidateId);
   allow create: if isActiveUser()
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.module == 'interview_lab'
   && request.resource.data.sessionId is string
   && exists(
   /databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId)
   )
   && get(
   /databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId)
   ).data.candidateId == request.auth.uid;
   allow update: if isAdmin();
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
  }

  match /interview_results/{resultId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(resource.data.candidateId);
   allow create: if isActiveUser()
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.module == 'interview_lab'
   && request.resource.data.sessionId is string
   && exists(
   /databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId)
   )
   && get(
   /databases/$(database)/documents/interview_sessions/$(request.resource.data.sessionId)
   ).data.candidateId == request.auth.uid;
   allow update: if isAdmin();
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
  }

  match /interview_history/{historyId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(resource.data.candidateId);
   allow create: if isActiveUser()
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.module == 'interview_lab';
   allow update: if false;
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
  }

  match /interview_badges/{badgeId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(resource.data.candidateId);
   allow create: if isActiveUser()
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.module == 'interview_lab';
   allow update: if false;
   allow delete: if isAdmin()
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
  }

  match /interview_progress/{candidateId} {
   allow read: if isAdmin()
   || (
   isActiveUser()
   && candidateId == request.auth.uid
   )
   || hasBoundHiringCandidateAccess(candidateId);
   allow create, update: if isActiveUser()
   && candidateId == request.auth.uid
   && request.resource.data.candidateId == request.auth.uid
   && request.resource.data.module == 'interview_lab';
   allow delete: if isAdmin();
  }

  match /hiring_candidate_access/{accessId} {
   allow read: if isAdmin()
   || (
   hasRole('company')
   && resource.data.companyId == request.auth.uid
   )
   || (
   isActiveUser()
   && resource.data.candidateId == request.auth.uid
   );
   allow create, update: if isAdmin()
   || (
   hiringAccessWriteValid()
   && accessId
   == (request.resource.data.companyId + '_' + request.resource.data.candidateId)
   && (
   (
   hasRole('company')
   && request.resource.data.companyId == request.auth.uid
   )
   || (
   (hasRole('student') || hasRole('freelancer'))
   && request.resource.data.candidateId == request.auth.uid
   )
   )
   );
   allow delete: if isAdmin();
  }

  match /careerIntelligence/{userId} {
   allow read: if isAdmin()
   || (signedIn() && request.auth.uid == userId);
   allow create, update: if signedIn()
   && request.auth.uid == userId
   && request.resource.data.userId == request.auth.uid;
   allow delete: if isAdmin()
   || (signedIn() && request.auth.uid == userId);
  }

  match /career_badges/{badgeId} {
   allow read: if isAdmin()
   || (signedIn() && resource.data.userId == request.auth.uid);
   allow create: if signedIn()
   && request.resource.data.userId == request.auth.uid;
   allow update, delete: if isAdmin()
   || (signedIn() && resource.data.userId == request.auth.uid);
  }

  match /user_notifications/{notificationId} {
   allow read: if isAdmin()
   || (signedIn() && resource.data.userId == request.auth.uid);

   allow create: if isAdmin()
   || (
   signedIn()
   && request.resource.data.keys().hasAll(['userId', 'title', 'body', 'type', 'category', 'event', 'relatedPath', 'createdAt', 'read'])
   && request.resource.data.read == false
   && request.resource.data.userId is string
   && request.resource.data.title is string
   && request.resource.data.body is string
   && (
   request.resource.data.userId == request.auth.uid
   || notifHiringPeer()
   || notifBatchPeer()
   || notifCoursePeer()
   || notifSrPeer()
   || notifSoPeer()
   || (
   exists(adminPath(request.resource.data.userId))
   && request.resource.data.event in ['support.ticket_created', 'support.dispute_opened', 'admin.payout_requested']
   )
   )
   );

   allow update: if signedIn()
   && resource.data.userId == request.auth.uid
   && request.resource.data.diff(resource.data).affectedKeys()
   .hasOnly(['read']);

   allow delete: if isAdmin()
   || (signedIn() && resource.data.userId == request.auth.uid);
  }

  match /teacherWallets/{teacherId} {
allow read: if isAdmin() || (signedIn() && request.auth.uid == teacherId);
allow create: if signedIn() && request.auth.uid == teacherId && request.resource.data.teacherId == teacherId && request.resource.data.walletId == teacherId && request.resource.data.availableBalance == 0 && request.resource.data.pendingBalance == 0 && request.resource.data.lifetimeEarnings == 0 && request.resource.data.lifetimeWithdrawn == 0;
allow update: if signedIn() && request.auth.uid == teacherId && request.resource.data.teacherId == teacherId && request.resource.data.walletId == resource.data.walletId && request.resource.data.availableBalance >= 0 && request.resource.data.pendingBalance >= 0 && request.resource.data.lifetimeEarnings >= 0 && request.resource.data.lifetimeWithdrawn >= resource.data.lifetimeWithdrawn && request.resource.data.lifetimeWithdrawn <= resource.data.lifetimeWithdrawn + resource.data.availableBalance + 0.01 && request.resource.data.availableBalance + request.resource.data.pendingBalance + request.resource.data.lifetimeWithdrawn <= request.resource.data.lifetimeEarnings + 0.01;
allow delete: if false;
}
match /teacherWalletTransactions/{transactionId} {
allow read: if isAdmin() || (signedIn() && resource.data.teacherId == request.auth.uid);
allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid && request.resource.data.amount > 0;
allow update, delete: if false;
}
match /employmentHrThreads/{threadId} {
allow read: if signedIn() && (isAdmin() || isHrParty(resource.data));
allow create: if signedIn() && isHrParty(request.resource.data) && request.resource.data.applicationId is string && request.resource.data.companyId is string && request.resource.data.applicantId is string;
allow update: if signedIn() && isHrParty(resource.data) && request.resource.data.companyId == resource.data.companyId && request.resource.data.applicantId == resource.data.applicantId && request.resource.data.applicationId == resource.data.applicationId;
allow delete: if isAdmin();
match /messages/{messageId} {
allow read: if signedIn() && (isAdmin() || (exists(/databases/$(database)/documents/employmentHrThreads/$(threadId)) && isHrParty(hrThread(threadId))));
allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.threadId == threadId && isHrParty(getAfter(/databases/$(database)/documents/employmentHrThreads/$(threadId)).data);
allow update, delete: if isAdmin();
}
}
match /{document=**} {
   allow read, write: if false;
  }

  match /settings/{document=**} {
   allow read: if true;
   allow write: if isAdmin();
  }
 }
}

