PORT=3001
HOST=0.0.0.0
NODE_ENV=production
AI_PROVIDER=openai
ENABLE_PROVIDER_FAILOVER=true
ENABLE_TEMPLATE_FALLBACK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PREMIUM_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGINS=
DEV_ALLOW_LOCALHOST=false
# Production MUST be true. Set false only for local unauthenticated debugging.
REQUIRE_AUTH=true
FIREBASE_PROJECT_ID=skillforge-ai-4f2da
# Service account for Firestore role binding + demo payment finalize. Prefer a file path:
# Download from Firebase Console → Project settings → Service accounts.
# FIREBASE_SERVICE_ACCOUNT_PATH=./skillforge-ai-4f2da-firebase-adminsdk-fbsvc-411016a137.json
# Or copy/rename that file to ./serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
MAX_PROMPT_CHARS=8000
REQUEST_TIMEOUT_MS=120000
DEBUG_OPENAI_ERRORS=false
DEBUG_GEMINI_ERRORS=false

# ── SkillForge Demo Gateway (Option A — no merchant ID, no real money) ──
# Default ON. Flutter checkout uses /api/demo/checkout + /api/demo/confirm.
DEMO_GATEWAY_ENABLED=true
DEMO_GATEWAY_CURRENCY=PKR
DEMO_GATEWAY_MERCHANT_NAME=SkillForge AI
DEMO_GATEWAY_BASE_URL=http://localhost:3001

# ── Stripe TEST / SANDBOX only (real card UI, no real money) ──
# Test keys only. The gateway refuses to boot on sk_live_ / pk_live_.
# Dashboard (test mode) → Developers → API keys.
STRIPE_ENABLED=true
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# Client-safe key. Flutter may hold pk_test_ only; never the secret key.
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
# From `stripe listen` (local) or Dashboard → Developers → Webhooks (test endpoint).
# Comma-separate to accept both the CLI secret and the deployed endpoint secret.
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
# PKR is charged as a ZERO-DECIMAL currency here: whole rupees, never x100.
STRIPE_CURRENCY=pkr
# Catalog items (credit packs / plans / courses) are priced in USD major units.
# Leave unset to charge those in USD ($5 → unit_amount 500). Set a rate to FX
# into PKR instead ($5 × 280 → 1400 PKR).
# STRIPE_USD_TO_PKR=280
# Public URL of THIS gateway (no trailing slash). Stripe redirects buyers here.
STRIPE_GATEWAY_BASE_URL=http://localhost:3001
# Optional overrides. {intentId} and {status} are substituted; success URLs may
# also contain Stripe's {CHECKOUT_SESSION_ID} placeholder.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Deep link offered on the gateway return page.
STRIPE_APP_RETURN_URL=skillforge://payment/return
STRIPE_MERCHANT_NAME=SkillForge AI
STRIPE_SESSION_EXPIRY_MINUTES=60
# Wallet top-up is the only buyer-chosen amount; everything else is priced from Firestore.
STRIPE_WALLET_TOPUP_MIN=100
STRIPE_WALLET_TOPUP_MAX=500000
# ── Stripe Connect Express (TEST mode) — teacher/freelancer payout splits ──
# Requires Connect enabled on the Stripe TEST account. Checkout falls back to
# platform-only charges when a seller has not onboarded.
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_COUNTRY=PK
# Pin only if you need a specific Stripe API version.
STRIPE_API_VERSION=

# ── PayFast Pakistan (optional live gateway — needs merchant approval) ──
# Get MERCHANT_ID + SECURED_KEY after registering at https://gopayfast.com/
# Docs: https://gopayfast.com/docs/
# Master switch: false = pause live PayFast checkouts
PAYFAST_ENABLED=false
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=SkillForge AI
PAYFAST_CURRENCY=PKR
PAYFAST_SANDBOX=false
# Public URL of THIS gateway (no trailing slash). Must be reachable by PayFast for IPN.
# Local: http://localhost:3001  |  Deployed: https://your-gateway.example.com
PAYFAST_GATEWAY_BASE_URL=http://localhost:3001
