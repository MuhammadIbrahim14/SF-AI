    match /resolutionCases/{caseId} {
      function isResolutionParticipant(data) {
        return signedIn()
          && (
            data.clientId == request.auth.uid
            || data.freelancerId == request.auth.uid
          );
      }

      function casePath() {
        return /databases/$(database)/documents/resolutionCases/$(caseId);
      }

      function linkedOrderPath(data) {
        return /databases/$(database)/documents/serviceOrders/$(data.orderId);
      }

      function linkedOrderMatches(data) {
        return data.orderId is string
          && exists(linkedOrderPath(data))
          && get(linkedOrderPath(data)).data.clientId == data.clientId
          && get(linkedOrderPath(data)).data.freelancerId == data.freelancerId
          && get(linkedOrderPath(data)).data.serviceRequestId == data.serviceRequestId
          && get(linkedOrderPath(data)).data.serviceId == data.serviceId;
