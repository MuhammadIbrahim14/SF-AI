        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.openedBy == request.resource.data.requestedBy
        && request.resource.data.openedByRole == request.resource.data.requestedByRole
        && request.resource.data.evidenceRequired is bool
        && request.resource.data.clientEvidence is list
        && request.resource.data.freelancerEvidence is list
        && request.resource.data.orderSnapshot is map
        && (
