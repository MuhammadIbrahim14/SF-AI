          isActiveUser()
          && resource.data.candidateId == request.auth.uid
        );
      // Access docs must bind to an owned application (company + candidate + job).
      allow create, update: if isAdmin()
        || (
          hiringAccessWriteValid()
          && accessId
            == (request.resource.data.companyId + '_' + request.resource.data.candidateId)
          && (
            (
              hasRole('company')
              && request.resource.data.companyId == request.auth.uid
            )
            || (
              (hasRole('student') || hasRole('freelancer'))
              && request.resource.data.candidateId == request.auth.uid
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /careerIntelligence/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
    }

    match /career_badges/{badgeId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
