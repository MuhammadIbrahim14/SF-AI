          ]);

      allow update: if isAdmin()
        && request.resource.data.walletId == resource.data.walletId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.status in ['active', 'frozen']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);

      allow update: if isAdmin()
        && resource.data.status == 'active'
        && immutableCustomerWalletFieldsUnchanged()
        && request.resource.data.status == resource.data.status
        && request.resource.data.totalAdded == resource.data.totalAdded
        && request.resource.data.totalSpent == resource.data.totalSpent
        && request.resource.data.availableBalance >= resource.data.availableBalance
        && request.resource.data.totalRefunded >= resource.data.totalRefunded
        && request.resource.data.totalEscrowed <= resource.data.totalEscrowed
        && request.resource.data.totalEscrowed >= 0
        && request.resource.data.availableBalance - resource.data.availableBalance
