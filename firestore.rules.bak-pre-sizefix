          && request.resource.data.batchId is string
          ? request.resource.data.batchId
          : (
            request.resource.data.keys().hasAny(['meta'])
              && request.resource.data.meta is map
              && request.resource.data.meta.keys().hasAny(['batchId'])
              && request.resource.data.meta.batchId is string
              ? request.resource.data.meta.batchId
              : ''
          );
      }

      function notificationCourseId() {
        return request.resource.data.keys().hasAny(['courseId'])
          && request.resource.data.courseId is string
          ? request.resource.data.courseId
          : (
            request.resource.data.keys().hasAny(['meta'])
              && request.resource.data.meta is map
              && request.resource.data.meta.keys().hasAny(['courseId'])
              && request.resource.data.meta.courseId is string
              ? request.resource.data.meta.courseId
              : ''
          );
      }

      // Teacher owns the batch (roster / join decisions), or student may notify
      // that batch's teacher (join request).
      function canNotifyViaBatch() {
        let batchId = notificationBatchId();
        return batchId is string
          && batchId.size() > 0
          && exists(teacherBatchPath(batchId))
          && (
            get(teacherBatchPath(batchId)).data.teacherId == request.auth.uid
            || (
              hasRole('student')
              && request.resource.data.userId
                == get(teacherBatchPath(batchId)).data.teacherId
            )
          );
      }

      // Teacher owns the course and recipient is enrolled in it.
      function canNotifyViaLearning() {
        let courseId = notificationCourseId();
        return courseId is string
          && courseId.size() > 0
          && ownsCourse(courseId)
          && exists(enrollmentPath(courseId, request.resource.data.userId));
      }

      // Company ↔ applicant peer via applications/{applicationId}.
      function canNotifyViaHiringPeer() {
        return request.resource.data.applicationId is string
          && exists(applicationPath(request.resource.data.applicationId))
          && (
            get(applicationPath(request.resource.data.applicationId)).data.companyId
              == request.auth.uid
            || get(applicationPath(request.resource.data.applicationId)).data.applicantId
              == request.auth.uid
          )
          && (
            request.resource.data.userId
              == get(applicationPath(request.resource.data.applicationId)).data.companyId
            || request.resource.data.userId
              == get(applicationPath(request.resource.data.applicationId)).data.applicantId
          );
      }

      // Client ↔ freelancer peer via serviceRequests or serviceOrders.
      function notificationServiceRequestId() {
        return request.resource.data.keys().hasAny(['serviceRequestId'])
          && request.resource.data.serviceRequestId is string
          ? request.resource.data.serviceRequestId
          : (
            request.resource.data.keys().hasAny(['meta'])
              && request.resource.data.meta is map
              && request.resource.data.meta.keys().hasAny(['serviceRequestId'])
              && request.resource.data.meta.serviceRequestId is string
              ? request.resource.data.meta.serviceRequestId
              : ''
          );
      }

      function notificationOrderId() {
        return request.resource.data.keys().hasAny(['orderId'])
          && request.resource.data.orderId is string
          ? request.resource.data.orderId
          : (
            request.resource.data.keys().hasAny(['meta'])
              && request.resource.data.meta is map
              && request.resource.data.meta.keys().hasAny(['orderId'])
              && request.resource.data.meta.orderId is string
              ? request.resource.data.meta.orderId
              : ''
          );
      }

      function serviceRequestPath(requestId) {
        return /databases/$(database)/documents/serviceRequests/$(requestId);
      }

      function serviceOrderPath(orderId) {
        return /databases/$(database)/documents/serviceOrders/$(orderId);
      }

      function canNotifyViaCommerceRequest() {
        let requestId = notificationServiceRequestId();
        return requestId is string
          && requestId.size() > 0
          && exists(serviceRequestPath(requestId))
          && (
            get(serviceRequestPath(requestId)).data.clientId == request.auth.uid
            || get(serviceRequestPath(requestId)).data.freelancerId
              == request.auth.uid
          )
          && (
            request.resource.data.userId
              == get(serviceRequestPath(requestId)).data.clientId
            || request.resource.data.userId
              == get(serviceRequestPath(requestId)).data.freelancerId
          );
      }

      function canNotifyViaCommerceOrder() {
        let orderId = notificationOrderId();
        return orderId is string
          && orderId.size() > 0
          && exists(serviceOrderPath(orderId))
          && (
            get(serviceOrderPath(orderId)).data.clientId == request.auth.uid
            || get(serviceOrderPath(orderId)).data.freelancerId
              == request.auth.uid
          )
          && (
            request.resource.data.userId
              == get(serviceOrderPath(orderId)).data.clientId
            || request.resource.data.userId
              == get(serviceOrderPath(orderId)).data.freelancerId
          );
      }

      function canNotifyViaCommerce() {
        return canNotifyViaCommerceRequest() || canNotifyViaCommerceOrder();
      }

      // Ticket owner may fan-out support.ticket_created to admins/{uid} docs.
      function supportTicketMessageId() {
        return request.resource.data.keys().hasAny(['meta'])
          && request.resource.data.meta is map
          && request.resource.data.meta.keys().hasAny(['messageId'])
          && request.resource.data.meta.messageId is string
          ? request.resource.data.meta.messageId
          : '';
      }

      function canNotifySupportTicketCreated() {
        let messageId = supportTicketMessageId();
        return request.resource.data.category == 'support'
          && request.resource.data.event == 'support.ticket_created'
          && messageId is string
          && messageId.size() > 0
          && exists(
            /databases/$(database)/documents/contactMessages/$(messageId)
          )
          && get(
            /databases/$(database)/documents/contactMessages/$(messageId)
          ).data.get('userId', '') == request.auth.uid
          && exists(adminPath(request.resource.data.userId));
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.keys().hasAll([
            'userId',
            'title',
            'body',
            'type',
            'category',
            'event',
            'relatedPath',
            'createdAt',
            'read'
          ])
          && request.resource.data.read == false
          && request.resource.data.userId is string
          && request.resource.data.title is string
          && request.resource.data.body is string
          && (
            // Self-notify (rare; keeps legacy path)
            request.resource.data.userId == request.auth.uid
            || canNotifyViaHiringPeer()
            || canNotifyViaBatch()
            || canNotifyViaLearning()
            || canNotifyViaCommerce()
            || canNotifySupportTicketCreated()
          )
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
