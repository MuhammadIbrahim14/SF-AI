        && actorOwnsLinkedOrder(request.resource.data)
        && validCaseType(request.resource.data.type)
        && validCaseStatus(request.resource.data.status)
        && validRequestedByRole(request.resource.data.requestedByRole)
        && validPriority(request.resource.data.priority)
        && request.resource.data.resolutionDecision == 'none'
