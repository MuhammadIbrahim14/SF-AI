        && resource.data.totalEscrowed - request.resource.data.totalEscrowed
          == getAfter(
            /databases/$(database)/documents/serviceOrders/$(request.resource.data.lastReleaseOrderId)
          ).data.totalAmount
        && request.resource.data.totalEscrowed >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
